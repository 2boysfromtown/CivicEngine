    combined_output {
      full: "/** * @license * SPDX-License-Identifier: Apache-2.0 */import React, { useState } from \'react\';import VoiceReporter from \'./components/VoiceReporter\';import AuthorityDashboard from \'./components/Dashboard\';import { Shield, Mic, User as UserIcon, LogOut, Globe } from \'lucide-react\';import { clsx, type ClassValue } from \'clsx\';import { twMerge } from \'tailwind-merge\';function cn(...inputs: ClassValue[]) {  return twMerge(clsx(inputs));}type User = {  role: \'citizen\' | \'authority\';  language?: string;  name?: string;};const LANGUAGES = [  { code: \'en\', name: \'English\' },  { code: \'hi\', name: \'Hindi / \340\244\271\340\244\277\340\244\250\340\245\215\340\244\246\340\245\200\' },  { code: \'ta\', name: \'Tamil / \340\256\244\340\256\256\340\256\277\340\256\264\340\257\215\' },  { code: \'kn\', name: \'Kannada / \340\262\225\340\262\250\340\263\215\340\262\250\340\262\241\' },  { code: \'te\', name: \'Telugu / \340\260\244\340\261\206\340\260\262\340\261\201\340\260\227\340\261\201\' }];export default function App() {  const [user, setUser] = useState<User | null>(null);  const [authView, setAuthView] = useState<\'login\' | \'signup\'>(\'login\');    // Auth Form State  const [name, setName] = useState(\'\');  const [role, setRole] = useState<\'citizen\' | \'authority\'>(\'citizen\');  const [language, setLanguage] = useState(\'en\');  const handleLogin = (e: React.FormEvent) => {    e.preventDefault();    // Mock login, defaulting to citizen English if not setup    setUser({ role: \'citizen\', language: \'en\', name: \'Citizen User\' });  };  const handleSignup = (e: React.FormEvent) => {    e.preventDefault();    setUser({ role, language, name });  };  if (!user) {    return (      <div className=\"min-h-screen bg-sandalwood-50 font-sans flex items-center justify-center p-6 selection:bg-sandalwood-200\">        <div className=\"w-full max-w-md bg-white p-8 rounded-2xl shadow-xl border border-sandalwood-200\">          <div className=\"flex justify-center mb-8\">            <div className=\"w-12 h-12 rounded-xl bg-black text-white flex items-center justify-center\">              <Shield size={24} />            </div>          </div>                    <h1 className=\"text-2xl font-bold text-center text-black tracking-tight mb-2\">            CivicEngine          </h1>          <p className=\"text-center text-sandalwood-600 mb-8 font-medium\">            {authView === \'login\' ? \'Sign in to continue\' : \'Create your account\'}          </p>          <form onSubmit={authView === \'login\' ? handleLogin : handleSignup} className=\"space-y-5\">            {authView === \'signup\' && (              <>                <div>                  <label className=\"block text-sm font-semibold text-black mb-1\">Name</label>                  <input                     type=\"text\"                     required                     value={name}                    onChange={e => setName(e.target.value)}                    className=\"w-full px-4 py-2 bg-sandalwood-50 border border-sandalwood-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-black focus:border-transparent text-black\"                    placeholder=\"Your full name\"                  />                </div>                                <div>                  <label className=\"block text-sm font-semibold text-black mb-1 flex items-center gap-2\">                    <Globe size={16} /> Preferred Language                  </label>                  <select                     value={language}                    onChange={e => setLanguage(e.target.value)}                    className=\"w-full px-4 py-2 bg-sandalwood-50 border border-sandalwood-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-black text-black\"                  >                    {LANGUAGES.map(lang => (                      <option key={lang.code} value={lang.code}>{lang.name}</option>                    ))}                  </select>                </div>                <div>                  <label className=\"block text-sm font-semibold text-black mb-2\">Account Type</label>                  <div className=\"grid grid-cols-2 gap-3\">                    <button                      type=\"button\"                      onClick={() => setRole(\'citizen\')}                      className={cn(                        \"px-4 py-3 rounded-lg border font-medium text-sm transition-all\",                        role === \'citizen\' ? \"bg-black text-white border-black\" : \"bg-white text-black border-sandalwood-200 hover:border-black\"                      )}                    >                      Citizen                    </button>                    <button                      type=\"button\"                      onClick={() => setRole(\'authority\')}                      className={cn(                        \"px-4 py-3 rounded-lg border font-medium text-sm transition-all\",                        role === \'authority\' ? \"bg-black text-white border-black\" : \"bg-white text-black border-sandalwood-200 hover:border-black\"                      )}                    >                      Authority                    </button>                  </div>                </div>              </>            )}            {authView === \'login\' && (              <div>                <label className=\"block text-sm font-semibold text-black mb-1\">Email or Phone</label>                <input                   type=\"text\"                   required                   className=\"w-full px-4 py-2 bg-sandalwood-50 border border-sandalwood-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-black text-black\"                  placeholder=\"name@example.com\"                />              </div>            )}            <button type=\"submit\" className=\"w-full py-3 bg-black text-white font-bold rounded-lg hover:bg-sandalwood-900 transition-colors mt-4\">              {authView === \'login\' ? \'Sign In\' : \'Create Account\'}            </button>          </form>          <div className=\"mt-6 text-center text-sm font-medium\">            <span className=\"text-sandalwood-600\">              {authView === \'login\' ? \"Don\'t have an account? \" : \"Already have an account? \"}            </span>            <button               onClick={() => setAuthView(authView === \'login\' ? \'signup\' : \'login\')}              className=\"text-black hover:underline font-bold\"            >              {authView === \'login\' ? \'Sign Up\' : \'Log In\'}            </button>          </div>        </div>      </div>    );  }  return (    <div className=\"min-h-screen bg-sandalwood-50 font-sans selection:bg-sandalwood-300 flex flex-col\">      <nav className=\"border-b border-sandalwood-200 bg-white sticky top-0 z-50\">        <div className=\"max-w-7xl mx-auto px-6 h-16 flex items-center justify-between\">          <div className=\"flex items-center gap-3\">            <div className=\"w-8 h-8 rounded-lg bg-black flex items-center justify-center\">              <Shield className=\"text-white\" size={16} />            </div>            <span className=\"font-bold text-black tracking-tight\">CivicEngine</span>          </div>          <div className=\"flex items-center gap-4\">            <div className=\"flex items-center gap-2 text-sm font-medium text-black bg-sandalwood-100 px-3 py-1.5 rounded-full border border-sandalwood-200\">              <UserIcon size={14} />              {user.name || (user.role === \'citizen\' ? \'Citizen\' : \'Authority\')}            </div>            <button               onClick={() => setUser(null)}              className=\"text-sandalwood-600 hover:text-black transition-colors\"              title=\"Log out\"            >              <LogOut size={20} />            </button>          </div>        </div>      </nav>      <main className=\"flex-1 max-w-7xl mx-auto w-full p-6\">        {user.role === \'citizen\' ? (          <div className=\"flex items-center justify-center min-h-[calc(100vh-120px)] animate-in fade-in duration-500\">            <div className=\"w-full\">              <VoiceReporter language={user.language || \'en\'} />            </div>          </div>        ) : (          <div className=\"animate-in fade-in duration-500\">            <AuthorityDashboard />          </div>        )}      </main>    </div>  );}"
    }
    command_line: "cat src/App.tsx"
    proposed_command_line: "cat src/App.tsx"
