  file_change {
    absolute_path_uri: "file:///src/components/VoiceReporter.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { useState, useRef } from \'react\';\nimport { Mic, Square, Loader2, CheckCircle2 } from \'lucide-react\';\n\nexport default function VoiceReporter() {\n  const [isRecording, setIsRecording] = useState(false);\n  const [uploading, setUploading] = useState(false);\n  const [success, setSuccess] = useState(false);\n  const mediaRecorderRef = useRef<MediaRecorder | null>(null);\n  const audioChunksRef = useRef<Blob[]>([]);\n\n  const startRecording = async () => {\n    try {\n      setSuccess(false);\n      audioChunksRef.current = [];\n      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });\n      const mediaRecorder = new MediaRecorder(stream, { mimeType: \'audio/webm\' });\n      \n      mediaRecorder.ondataavailable = (event) => {\n        if (event.data.size > 0) audioChunksRef.current.push(event.data);\n      };\n\n      mediaRecorder.onstop = async () => {\n        const audioBlob = new Blob(audioChunksRef.current, { type: \'audio/webm\' });\n        await sendToCivicEngine(audioBlob);\n      };\n\n      mediaRecorderRef.current = mediaRecorder;\n      mediaRecorder.start();\n      setIsRecording(true);\n    } catch (err) {\n      console.error(\'Microphone access denied or error:\', err);\n      alert(\'Could not access microphone.\');\n    }\n  };\n\n  const stopRecording = () => {\n    if (mediaRecorderRef.current && isRecording) {\n      mediaRecorderRef.current.stop();\n      mediaRecorderRef.current.stream.getTracks().forEach(track => track.stop());\n      setIsRecording(false);\n    }\n  };\n\n  const sendToCivicEngine = async (audioBlob: Blob) => {\n    setUploading(true);\n    const formData = new FormData();\n    formData.append(\'audio\', audioBlob, \'report.webm\');\n    \n    const sendData = async (lat: string, lng: string) => {\n      formData.append(\'lat\', lat);\n      formData.append(\'lng\', lng);\n      try {\n        const res = await fetch(\'/api/process-civic-report\', {\n          method: \'POST\',\n          body: formData,\n        });\n        const data = await res.json();\n        console.log(\'Engine Response Parsed:\', data);\n        setSuccess(true);\n      } catch (err) {\n        console.error(\'Network execution failure:\', err);\n      } finally {\n        setUploading(false);\n      }\n    };\n\n    if (navigator.geolocation) {\n      navigator.geolocation.getCurrentPosition(\n        (pos) => sendData(pos.coords.latitude.toString(), pos.coords.longitude.toString()),\n        (err) => {\n          console.warn(\'Geolocation failed:\', err);\n          sendData(\'0\', \'0\'); // Fallback coordinates\n        }\n      );\n    } else {\n      sendData(\'0\', \'0\'); // Fallback coordinates\n    }\n  };\n\n  return (\n    <div className=\"p-8 max-w-md mx-auto bg-slate-900 text-white rounded-2xl shadow-xl border border-slate-800 flex flex-col items-center\">\n      <h3 className=\"text-2xl font-bold mb-3 text-center tracking-tight\">Civic Voice Agent</h3>\n      <p className=\"text-sm text-slate-400 mb-8 text-center leading-relaxed\">\n        Hold record to state an issue or criticize an ongoing municipal project. Audio is auto-translated and verified by our civic engine.\n      </p>\n      \n      <div className=\"flex justify-center items-center mb-6 h-32\">\n        {!isRecording && !uploading && !success && (\n          <button \n            onClick={startRecording} \n            className=\"h-24 w-24 rounded-full bg-red-600 hover:bg-red-500 flex items-center justify-center font-semibold transition-all shadow-[0_0_40px_rgba(220,38,38,0.4)] hover:scale-105\"\n            aria-label=\"Start Recording\"\n          >\n            <Mic size={36} className=\"text-white\" />\n          </button>\n        )}\n        {isRecording && !uploading && (\n          <button \n            onClick={stopRecording} \n            className=\"h-24 w-24 rounded-full bg-slate-800 animate-pulse flex items-center justify-center font-semibold transition-all border-4 border-red-500 hover:scale-105\"\n            aria-label=\"Stop Recording\"\n          >\n            <Square size={28} className=\"text-red-500\" fill=\"currentColor\" />\n          </button>\n        )}\n        {uploading && (\n          <div className=\"flex flex-col items-center space-y-4 text-amber-400\">\n            <Loader2 size={40} className=\"animate-spin\" />\n            <span className=\"text-sm font-medium\">Analyzing Multimodal Input...</span>\n          </div>\n        )}\n        {success && (\n          <div className=\"flex flex-col items-center space-y-4 text-emerald-400\">\n            <CheckCircle2 size={48} />\n            <span className=\"text-sm font-medium\">Report logged securely.</span>\n            <button \n              onClick={() => setSuccess(false)}\n              className=\"mt-4 px-4 py-2 bg-slate-800 text-white text-sm rounded-lg hover:bg-slate-700 transition\"\n            >\n              Report another issue\n            </button>\n          </div>\n        )}\n      </div>\n      \n      {isRecording && (\n        <div className=\"flex items-center space-x-2 text-red-400 text-sm font-medium animate-pulse\">\n          <div className=\"h-2 w-2 bg-red-500 rounded-full\" />\n          <span>Recording live...</span>\n        </div>\n      )}\n    </div>\n  );\n}\n"
    }
