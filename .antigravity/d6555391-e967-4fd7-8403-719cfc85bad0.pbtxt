    replacement_chunks {
      target_content: "          <div className=\"space-y-4\">\n            {sortedIssues.map(issue => (\n              <div key={issue.issue_id} className=\"bg-white rounded-xl shadow-sm border border-sandalwood-200 overflow-hidden flex\">\n                {/* Vote column */}\n                <div className=\"w-12 bg-sandalwood-50 flex flex-col items-center py-4 border-r border-sandalwood-100 shrink-0\">\n                  <button \n                    onClick={() => handleUpvoteIssue(issue.issue_id)} \n                    className={cn(\n                      \"transition-colors p-1.5 rounded-lg hover:bg-sandalwood-100\",\n                      issue.upvoted_by?.includes(localStorage.getItem(\'civic_reporter_user_id\') || \'\')\n                        ? \"text-green-600 bg-green-50 hover:bg-green-100\"\n                        : \"text-sandalwood-500 hover:text-black\"\n                    )}\n                    title=\"Upvote issue\"\n                  >\n                    <ThumbsUp size={18} fill={issue.upvoted_by?.includes(localStorage.getItem(\'civic_reporter_user_id\') || \'\') ? \"currentColor\" : \"none\"} />\n                  </button>\n                  <span className={cn(\n                    \"font-bold text-sm my-1\",\n                    issue.upvoted_by?.includes(localStorage.getItem(\'civic_reporter_user_id\') || \'\') ? \"text-green-600\" : \"text-black\"\n                  )}>{issue.citizen_upvote_count}</span>\n                </div>\n                \n                {/* Content */}\n                <div className=\"p-4 flex-1\">\n                  <div className=\"flex justify-between items-start mb-2\">\n                    <span className=\"text-xs font-bold text-sandalwood-700 bg-sandalwood-100 px-2 py-0.5 rounded flex items-center gap-1\">\n                      <AlertTriangle size={12} /> {issue.category}\n                    </span>\n                    <span className=\"text-xs font-medium text-sandalwood-500\">\n                      {new Date(issue.created_at).toLocaleDateString()}\n                    </span>\n                  </div>\n                  <h3 className=\"font-medium text-black text-sm md:text-base leading-snug mb-2\">{issue.executive_summary}</h3>\n                  <div className=\"flex gap-4 text-xs font-medium text-sandalwood-500 mt-3 pt-3 border-t border-sandalwood-100\">\n                    <div className=\"flex items-center gap-1\"><MessageSquare size={14} /> 0 {t(language, \'comments\')}</div>\n                    <div className=\"flex items-center gap-1 text-red-600 bg-red-50 px-1.5 rounded\">{t(language, \'severity\')} {issue.severity_score}</div>\n                  </div>\n                </div>\n              </div>\n            ))}\n          </div>"
      replacement_content: "          <div className=\"space-y-4\">\n            {sortedIssues.map(issue => {\n              const isSpam = issue.status === \'REJECTED\';\n              const isVerified = issue.is_verified;\n              \n              return (\n                <div \n                  key={issue.issue_id} \n                  className={cn(\n                    \"bg-white rounded-xl shadow-sm border overflow-hidden flex flex-col md:flex-row transition-all hover:shadow-md\",\n                    isSpam \n                      ? \"border-red-200 bg-red-50/20\" \n                      : \"border-sandalwood-200\"\n                  )}\n                >\n                  <div className=\"flex flex-1\">\n                    {/* Vote column */}\n                    <div className={cn(\n                      \"w-12 flex flex-col items-center py-4 border-r shrink-0 justify-start\",\n                      isSpam ? \"bg-red-50/50 border-red-100\" : \"bg-sandalwood-50 border-sandalwood-100\"\n                    )}>\n                      <button \n                        onClick={() => !isSpam && handleUpvoteIssue(issue.issue_id)} \n                        disabled={isSpam}\n                        className={cn(\n                          \"transition-colors p-1.5 rounded-lg hover:bg-sandalwood-100\",\n                          issue.upvoted_by?.includes(localStorage.getItem(\'civic_reporter_user_id\') || \'\')\n                            ? \"text-green-600 bg-green-50 hover:bg-green-100\"\n                            : \"text-sandalwood-500 hover:text-black disabled:opacity-30\"\n                        )}\n                        title=\"Upvote issue\"\n                      >\n                        <ThumbsUp size={18} fill={issue.upvoted_by?.includes(localStorage.getItem(\'civic_reporter_user_id\') || \'\') ? \"currentColor\" : \"none\"} />\n                      </button>\n                      <span className={cn(\n                        \"font-bold text-sm my-1\",\n                        issue.upvoted_by?.includes(localStorage.getItem(\'civic_reporter_user_id\') || \'\') ? \"text-green-600\" : \"text-black\"\n                      )}>{issue.citizen_upvote_count}</span>\n                    </div>\n                    \n                    {/* Content */}\n                    <div className=\"p-4 flex-1 flex flex-col justify-between\">\n                      <div>\n                        <div className=\"flex flex-wrap items-center justify-between gap-2 mb-2\">\n                          <div className=\"flex items-center gap-1.5\">\n                            <span className={cn(\n                              \"text-xs font-bold px-2 py-0.5 rounded flex items-center gap-1 uppercase tracking-wider\",\n                              isSpam \n                                ? \"text-red-700 bg-red-100\" \n                                : \"text-sandalwood-700 bg-sandalwood-100\"\n                            )}>\n                              <AlertTriangle size={12} /> {issue.category}\n                            </span>\n                            \n                            {isVerified && (\n                              <span className=\"text-[10px] font-extrabold bg-green-100 text-green-700 border border-green-200 px-1.5 py-0.5 rounded-full flex items-center gap-0.5 uppercase tracking-wide\">\n                                \342\234\223 AI Verified\n                              </span>\n                            )}\n                            \n                            {isSpam && (\n                              <span className=\"text-[10px] font-extrabold bg-red-100 text-red-700 border border-red-200 px-1.5 py-0.5 rounded-full uppercase tracking-wide\">\n                                \342\235\214 Spam Filtered\n                              </span>\n                            )}\n                          </div>\n                          \n                          <span className=\"text-xs font-mono font-medium text-sandalwood-500\">\n                            {new Date(issue.created_at).toLocaleDateString()}\n                          </span>\n                        </div>\n\n                        <h3 className={cn(\n                          \"font-bold text-black text-sm md:text-base leading-snug mb-2\",\n                          isSpam && \"line-through text-sandalwood-500\"\n                        )}>\n                          {issue.executive_summary}\n                        </h3>\n\n                        {/* Visual analysis detail if verified */}\n                        {issue.visual_analysis && (\n                          <p className=\"text-[11px] text-sandalwood-600 bg-sandalwood-50/60 p-2 rounded-lg border border-sandalwood-100/50 mb-3 leading-relaxed font-medium\">\n                            <strong className=\"text-black block text-[10px] uppercase tracking-wider mb-0.5 font-bold\">\360\237\244\226 Gemini Visual Analysis:</strong>\n                            \"{issue.visual_analysis}\"\n                          </p>\n                        )}\n\n                        {/* Spam Reason Warning */}\n                        {isSpam && issue.spam_reason && (\n                          <div className=\"text-[11px] text-red-700 bg-red-50 p-2.5 rounded-lg border border-red-100 mb-3 font-medium\">\n                            <strong className=\"text-red-800 block text-[10px] uppercase tracking-wider mb-0.5 font-extrabold\">\360\237\232\250 Filtered by Gemini Guardrails:</strong>\n                            {issue.spam_reason}\n                          </div>\n                        )}\n                      </div>\n\n                      <div className=\"flex gap-4 text-xs font-semibold text-sandalwood-500 mt-2 pt-3 border-t border-sandalwood-100/70 items-center\">\n                        <div className=\"flex items-center gap-1\"><MessageSquare size={14} /> 0 {t(language, \'comments\')}</div>\n                        <div className={cn(\n                          \"flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-bold\",\n                          issue.severity_score >= 4 ? \"bg-red-50 text-red-600\" : \"bg-sandalwood-50 text-sandalwood-700\"\n                        )}>\n                          {t(language, \'severity\')} {issue.severity_score}\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n\n                  {/* Optional Photo Attachment Display */}\n                  {issue.image_url && (\n                    <div className=\"w-full md:w-32 h-32 md:h-auto md:min-h-[120px] shrink-0 border-t md:border-t-0 md:border-l border-sandalwood-100 relative overflow-hidden bg-sandalwood-50\">\n                      <img \n                        src={issue.image_url} \n                        alt=\"Civic report visual evidence\"\n                        className=\"w-full h-full object-cover transition-transform hover:scale-110 duration-500\"\n                        referrerPolicy=\"no-referrer\"\n                      />\n                    </div>\n                  )}\n                </div>\n              );\n            })}\n          </div>"
    }
