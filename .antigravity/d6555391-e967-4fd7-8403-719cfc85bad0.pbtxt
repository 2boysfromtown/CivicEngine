  file_change {
    absolute_path_uri: "file:///src/App.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import { useState } from \'react\';\nimport VoiceReporter from \'./components/VoiceReporter\';\nimport AuthorityDashboard from \'./components/Dashboard\';\nimport { Shield, Mic } from \'lucide-react\';\nimport { clsx, type ClassValue } from \'clsx\';\nimport { twMerge } from \'tailwind-merge\';\n\nfunction cn(...inputs: ClassValue[]) {\n  return twMerge(clsx(inputs));\n}\n\nexport default function App() {\n  const [activeTab, setActiveTab] = useState<\'citizen\' | \'authority\'>(\'citizen\');\n\n  return (\n    <div className=\"min-h-screen bg-slate-950 font-sans selection:bg-indigo-500/30 flex flex-col\">\n      <nav className=\"border-b border-slate-800 bg-slate-900/50 backdrop-blur-sm sticky top-0 z-50\">\n        <div className=\"max-w-7xl mx-auto px-6 h-16 flex items-center justify-between\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-8 h-8 rounded-lg bg-indigo-500/20 border border-indigo-500/50 flex items-center justify-center\">\n              <Shield className=\"text-indigo-400\" size={18} />\n            </div>\n            <span className=\"font-bold text-white tracking-tight\">CivicEngine</span>\n          </div>\n          <div className=\"flex gap-2 p-1 bg-slate-950 rounded-lg border border-slate-800\">\n            <button\n              onClick={() => setActiveTab(\'citizen\')}\n              className={cn(\n                \"px-4 py-1.5 text-sm font-medium rounded-md transition-all flex items-center gap-2\",\n                activeTab === \'citizen\' ? \"bg-slate-800 text-white shadow-sm\" : \"text-slate-400 hover:text-white hover:bg-slate-900\"\n              )}\n            >\n              <Mic size={16} />\n              Citizen Intake\n            </button>\n            <button\n              onClick={() => setActiveTab(\'authority\')}\n              className={cn(\n                \"px-4 py-1.5 text-sm font-medium rounded-md transition-all flex items-center gap-2\",\n                activeTab === \'authority\' ? \"bg-indigo-600 text-white shadow-sm shadow-indigo-900/50\" : \"text-slate-400 hover:text-white hover:bg-slate-900\"\n              )}\n            >\n              <Shield size={16} />\n              Command Center\n            </button>\n          </div>\n        </div>\n      </nav>\n\n      <main className=\"flex-1 max-w-7xl mx-auto w-full p-6\">\n        {activeTab === \'citizen\' ? (\n          <div className=\"flex items-center justify-center min-h-[calc(100vh-120px)]\">\n            <div className=\"w-full\">\n              <VoiceReporter />\n            </div>\n          </div>\n        ) : (\n          <div className=\"animate-in fade-in duration-500\">\n            <AuthorityDashboard />\n          </div>\n        )}\n      </main>\n    </div>\n  );\n}"
      replacement_content: "import { useState } from \'react\';\nimport VoiceReporter from \'./components/VoiceReporter\';\nimport AuthorityDashboard from \'./components/Dashboard\';\nimport { Shield, Mic, User as UserIcon, LogOut, Globe } from \'lucide-react\';\nimport { clsx, type ClassValue } from \'clsx\';\nimport { twMerge } from \'tailwind-merge\';\n\nfunction cn(...inputs: ClassValue[]) {\n  return twMerge(clsx(inputs));\n}\n\ntype User = {\n  role: \'citizen\' | \'authority\';\n  language?: string;\n  name?: string;\n};\n\nconst LANGUAGES = [\n  { code: \'en\', name: \'English\' },\n  { code: \'hi\', name: \'Hindi / \340\244\271\340\244\277\340\244\250\340\245\215\340\244\246\340\245\200\' },\n  { code: \'ta\', name: \'Tamil / \340\256\244\340\256\256\340\256\277\340\256\264\340\257\215\' },\n  { code: \'kn\', name: \'Kannada / \340\262\225\340\262\250\340\263\215\340\262\250\340\262\241\' },\n  { code: \'te\', name: \'Telugu / \340\260\244\340\261\206\340\260\262\340\261\201\340\260\227\340\261\201\' }\n];\n\nexport default function App() {\n  const [user, setUser] = useState<User | null>(null);\n  const [authView, setAuthView] = useState<\'login\' | \'signup\'>(\'login\');\n  \n  // Auth Form State\n  const [name, setName] = useState(\'\');\n  const [role, setRole] = useState<\'citizen\' | \'authority\'>(\'citizen\');\n  const [language, setLanguage] = useState(\'en\');\n\n  const handleLogin = (e: React.FormEvent) => {\n    e.preventDefault();\n    // Mock login, defaulting to citizen English if not setup\n    setUser({ role: \'citizen\', language: \'en\', name: \'Citizen User\' });\n  };\n\n  const handleSignup = (e: React.FormEvent) => {\n    e.preventDefault();\n    setUser({ role, language, name });\n  };\n\n  if (!user) {\n    return (\n      <div className=\"min-h-screen bg-sandalwood-50 font-sans flex items-center justify-center p-6 selection:bg-sandalwood-200\">\n        <div className=\"w-full max-w-md bg-white p-8 rounded-2xl shadow-xl border border-sandalwood-200\">\n          <div className=\"flex justify-center mb-8\">\n            <div className=\"w-12 h-12 rounded-xl bg-black text-white flex items-center justify-center\">\n              <Shield size={24} />\n            </div>\n          </div>\n          \n          <h1 className=\"text-2xl font-bold text-center text-black tracking-tight mb-2\">\n            CivicEngine\n          </h1>\n          <p className=\"text-center text-sandalwood-600 mb-8 font-medium\">\n            {authView === \'login\' ? \'Sign in to continue\' : \'Create your account\'}\n          </p>\n\n          <form onSubmit={authView === \'login\' ? handleLogin : handleSignup} className=\"space-y-5\">\n            {authView === \'signup\' && (\n              <>\n                <div>\n                  <label className=\"block text-sm font-semibold text-black mb-1\">Name</label>\n                  <input \n                    type=\"text\" \n                    required \n                    value={name}\n                    onChange={e => setName(e.target.value)}\n                    className=\"w-full px-4 py-2 bg-sandalwood-50 border border-sandalwood-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-black focus:border-transparent text-black\"\n                    placeholder=\"Your full name\"\n                  />\n                </div>\n                \n                <div>\n                  <label className=\"block text-sm font-semibold text-black mb-1 flex items-center gap-2\">\n                    <Globe size={16} /> Preferred Language\n                  </label>\n                  <select \n                    value={language}\n                    onChange={e => setLanguage(e.target.value)}\n                    className=\"w-full px-4 py-2 bg-sandalwood-50 border border-sandalwood-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-black text-black\"\n                  >\n                    {LANGUAGES.map(lang => (\n                      <option key={lang.code} value={lang.code}>{lang.name}</option>\n                    ))}\n                  </select>\n                </div>\n\n                <div>\n                  <label className=\"block text-sm font-semibold text-black mb-2\">Account Type</label>\n                  <div className=\"grid grid-cols-2 gap-3\">\n                    <button\n                      type=\"button\"\n                      onClick={() => setRole(\'citizen\')}\n                      className={cn(\n                        \"px-4 py-3 rounded-lg border font-medium text-sm transition-all\",\n                        role === \'citizen\' ? \"bg-black text-white border-black\" : \"bg-white text-black border-sandalwood-200 hover:border-black\"\n                      )}\n                    >\n                      Citizen\n                    </button>\n                    <button\n                      type=\"button\"\n                      onClick={() => setRole(\'authority\')}\n                      className={cn(\n                        \"px-4 py-3 rounded-lg border font-medium text-sm transition-all\",\n                        role === \'authority\' ? \"bg-black text-white border-black\" : \"bg-white text-black border-sandalwood-200 hover:border-black\"\n                      )}\n                    >\n                      Authority\n                    </button>\n                  </div>\n                </div>\n              </>\n            )}\n\n            {authView === \'login\' && (\n              <div>\n                <label className=\"block text-sm font-semibold text-black mb-1\">Email or Phone</label>\n                <input \n                  type=\"text\" \n                  required \n                  className=\"w-full px-4 py-2 bg-sandalwood-50 border border-sandalwood-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-black text-black\"\n                  placeholder=\"name@example.com\"\n                />\n              </div>\n            )}\n\n            <button type=\"submit\" className=\"w-full py-3 bg-black text-white font-bold rounded-lg hover:bg-sandalwood-900 transition-colors mt-4\">\n              {authView === \'login\' ? \'Sign In\' : \'Create Account\'}\n            </button>\n          </form>\n\n          <div className=\"mt-6 text-center text-sm font-medium\">\n            <span className=\"text-sandalwood-600\">\n              {authView === \'login\' ? \"Don\'t have an account? \" : \"Already have an account? \"}\n            </span>\n            <button \n              onClick={() => setAuthView(authView === \'login\' ? \'signup\' : \'login\')}\n              className=\"text-black hover:underline font-bold\"\n            >\n              {authView === \'login\' ? \'Sign Up\' : \'Log In\'}\n            </button>\n          </div>\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"min-h-screen bg-sandalwood-50 font-sans selection:bg-sandalwood-300 flex flex-col\">\n      <nav className=\"border-b border-sandalwood-200 bg-white sticky top-0 z-50\">\n        <div className=\"max-w-7xl mx-auto px-6 h-16 flex items-center justify-between\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-8 h-8 rounded-lg bg-black flex items-center justify-center\">\n              <Shield className=\"text-white\" size={16} />\n            </div>\n            <span className=\"font-bold text-black tracking-tight\">CivicEngine</span>\n          </div>\n          <div className=\"flex items-center gap-4\">\n            <div className=\"flex items-center gap-2 text-sm font-medium text-black bg-sandalwood-100 px-3 py-1.5 rounded-full border border-sandalwood-200\">\n              <UserIcon size={14} />\n              {user.name || (user.role === \'citizen\' ? \'Citizen\' : \'Authority\')}\n            </div>\n            <button \n              onClick={() => setUser(null)}\n              className=\"text-sandalwood-600 hover:text-black transition-colors\"\n              title=\"Log out\"\n            >\n              <LogOut size={20} />\n            </button>\n          </div>\n        </div>\n      </nav>\n\n      <main className=\"flex-1 max-w-7xl mx-auto w-full p-6\">\n        {user.role === \'citizen\' ? (\n          <div className=\"flex items-center justify-center min-h-[calc(100vh-120px)] animate-in fade-in duration-500\">\n            <div className=\"w-full\">\n              <VoiceReporter language={user.language || \'en\'} />\n            </div>\n          </div>\n        ) : (\n          <div className=\"animate-in fade-in duration-500\">\n            <AuthorityDashboard />\n          </div>\n        )}\n      </main>\n    </div>\n  );\n}"
    }
