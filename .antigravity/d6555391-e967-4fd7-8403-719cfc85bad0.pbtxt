      target_content: "app.post(\'/api/process-civic-report\', upload.single(\'audio\'), async (req, res) => {\n  try {\n    const lat = req.body.lat;\n    const lng = req.body.lng;\n    const audioFile = req.file;\n    \n    if (!audioFile) {\n       return res.status(400).json({ error: \'Audio file is required\' });\n    }\n\n    const filePart = {\n      inlineData: {\n        data: audioFile.buffer.toString(\'base64\'),\n        mimeType: audioFile.mimetype,\n      },\n    };\n\n    const aiClient = getAI();\n    const response = await aiClient.models.generateContent({\n      model: \'gemini-1.5-pro\',\n      contents: [\n        {\n          role: \'user\',\n          parts: [\n            filePart,\n            { text: `Analyze this civic report. Coordinates: lat ${lat}, lng ${lng}` }\n          ]\n        }\n      ],\n      config: {\n        systemInstruction: SYSTEM_INSTRUCTION,\n        responseMimeType: \'application/json\',\n      }\n    });"
      replacement_content: "app.post(\'/api/process-civic-report\', upload.fields([{ name: \'audio\', maxCount: 1 }, { name: \'image\', maxCount: 1 }]), async (req, res) => {\n  try {\n    const lat = req.body.lat;\n    const lng = req.body.lng;\n    const textDesc = req.body.text || \'\';\n    \n    // Type checking for req.files when using upload.fields\n    const files = req.files as { [fieldname: string]: Express.Multer.File[] };\n    const audioFile = files?.[\'audio\']?.[0];\n    const imageFile = files?.[\'image\']?.[0];\n    \n    if (!audioFile && !imageFile && !textDesc) {\n       return res.status(400).json({ error: \'Please provide audio, image, or text description.\' });\n    }\n\n    const parts: any[] = [];\n    \n    if (audioFile) {\n      parts.push({\n        inlineData: {\n          data: audioFile.buffer.toString(\'base64\'),\n          mimeType: audioFile.mimetype,\n        },\n      });\n    }\n\n    if (imageFile) {\n      parts.push({\n        inlineData: {\n          data: imageFile.buffer.toString(\'base64\'),\n          mimeType: imageFile.mimetype,\n        },\n      });\n    }\n\n    let userPrompt = `Analyze this civic report. Coordinates: lat ${lat}, lng ${lng}.`;\n    if (textDesc) {\n       userPrompt += ` User provided text description: \"${textDesc}\"`;\n    }\n    parts.push({ text: userPrompt });\n\n    const aiClient = getAI();\n    const response = await aiClient.models.generateContent({\n      model: \'gemini-1.5-pro\',\n      contents: [\n        {\n          role: \'user\',\n          parts: parts\n        }\n      ],\n      config: {\n        systemInstruction: SYSTEM_INSTRUCTION,\n        responseMimeType: \'application/json\',\n      }\n    });"
    }
