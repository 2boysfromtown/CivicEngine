     fillOpacity: 0.8                     }}                   >                     <Popup>                       <div className=\"font-sans text-sm\">                         <div className=\"font-bold mb-1\">{issue.category}</div>                         <div className=\"text-xs mb-2 text-gray-600\">Priority: {issue.priority_score.toFixed(1)}</div>                         <div>{issue.executive_summary}</div>                       </div>                     </Popup>                   </CircleMarker>                 ))}               </MapContainer>            </div>          </div>          {/* Project Sentiment Monitor */}          <div className=\"bg-white rounded-2xl border border-sandalwood-200 overflow-hidden shadow-lg\">             <div className=\"p-4 border-b border-sandalwood-200 flex justify-between items-center bg-white\">              <h2 className=\"text-lg font-bold flex items-center gap-2 text-black\">                <TrendingUp size={18} className=\"text-sandalwood-600\" />                 Project Public Sentiment Monitor              </h2>            </div>            <div className=\"p-4 space-y-4\">              {projects.map(proj => (                <div key={proj.project_id} className=\"bg-sandalwood-50 p-5 rounded-xl border border-sandalwood-200\">                  <div className=\"flex justify-between items-start mb-2\">                    <div>                      <h3 className=\"font-bold text-black text-lg\">{proj.title}</h3>                      <p className=\"text-xs text-sandalwood-700 font-mono font-medium\">{proj.project_id} \342\200\242 {proj.department}</p>                    </div>                    <div className={cn(                      \"flex items-center gap-1 text-sm font-bold px-3 py-1.5 rounded-full border\",                      proj.sentiment_summary.ai_sentiment_index >= 0 ? \"bg-white text-black border-sandalwood-300\" : \"bg-black text-white border-black\"                    )}>                      {proj.sentiment_summary.ai_sentiment_index >= 0 ? <TrendingUp size={16} /> : <TrendingDown size={16} />}                      {proj.sentiment_summary.ai_sentiment_index > 0 ? \'+\' : \'\'}{proj.sentiment_summary.ai_sentiment_index.toFixed(2)}                    </div>                  </div>                                    <div className=\"mt-4 text-sm bg-white p-4 rounded-lg text-black border border-sandalwood-200\">                    <span className=\"text-xs font-bold text-sandalwood-600 uppercase tracking-wider block mb-1\">Top Criticism Theme</span>                    <span className=\"font-medium italic\">\"{proj.sentiment_summary.top_criticism_theme}\"</span>                  </div>                                    <div className=\"mt-4 flex gap-6 text-xs font-mono font-bold text-black border-t border-sandalwood-200 pt-3\">                     <span className=\"flex items-center gap-1\"><div className=\"w-2 h-2 rounded-full bg-sandalwood-400\"></div> POSITIVE: {proj.sentiment_summary.positive_votes}</span>                     <span className=\"flex items-center gap-1\"><div className=\"w-2 h-2 rounded-full bg-black\"></div> NEGATIVE: {proj.sentiment_summary.negative_criticisms}</span>                  </div>                </div>              ))}            </div>          </div>        </div>        {/* Right Column: Execution Queue */}        <div className=\"space-y-6\">          <div className=\"bg-white rounded-2xl border border-sandalwood-200 overflow-hidden shadow-lg h-full flex flex-col\">            <div className=\"p-4 border-b border-sandalwood-200 flex justify-between items-center bg-black\">              <h2 className=\"text-lg font-bold flex items-center gap-2 text-white\">                <AlertTriangle size={18} className=\"text-sandalwood-400\" />                 High-Priority Execution Queue              </h2>            </div>                        <div className=\"p-4 overflow-y-auto flex-1 space-y-4 bg-sandalwood-50\">              {issues.length === 0 ? (                <div className=\"text-center text-sandalwood-600 text-sm py-8 font-bold\">Queue is clear.</div>              ) : (                issues.map((issue) => (                  <div                     key={issue.issue_id}                     className={cn(                      \"p-5 rounded-xl border relative overflow-hidden transition-all shadow-sm\",                      issue.priority_score > 6                         ? \"bg-white border-black hover:shadow-md\"                         : \"bg-white border-sandalwood-200 hover:border-sandalwood-400\"                    )}                  >                    {issue.priority_score > 6 && (                       <div className=\"absolute top-0 left-0 w-1.5 h-full bg-black\" />                    )}                    <div className=\"flex justify-between items-start mb-3\">                      <span className=\"text-xs font-bold font-mono bg-sandalwood-200 px-2.5 py-1 rounded-md text-black\">                        {issue.category}                      </span>                      <span className={cn(                        \"text-sm font-bold font-mono px-2 py-0.5 rounded\",                        issue.priority_score > 6 ? \"bg-black text-white\" : \"text-sandalwood-800 bg-sandalwood-100\"                      )}>                        PRI: {issue.priority_score.toFixed(1)}                      </span>                    </div>                    <p className=\"text-sm text-black mt-2 leading-relaxed font-medium\">                      {issue.executive_summary}                    </p>                    <div className=\"mt-5 flex items-center justify-between text-xs text-sandalwood-600 font-mono font-bold pt-3 border-t border-sandalwood-100\">                      <div className=\"flex items-center gap-1.5\">                         <Clock size={14} />                         {new Date(issue.created_at).toLocaleDateString()}                      </div>                      <div className=\"flex items-center gap-1.5 text-black\">                        <CheckCircle size={14} className=\"text-sandalwood-600\" />                        {issue.citizen_upvote_count} Upvotes                      </div>                    </div>                  </div>                ))              )}            </div>          </div>        </div>      </div>    </div>  );}"
