      target_content: "export default function CitizenDashboard({ language }: { language: string }) {\n  const [location, setLocation] = useState<[number, number]>([12.687, 78.615]);\n  const [issues, setIssues] = useState<any[]>([]);\n  const [projects, setProjects] = useState<any[]>([]);\n  const [activeTab, setActiveTab] = useState<\'feed\' | \'map\'>(\'feed\');\n\n  useEffect(() => {\n    if (navigator.geolocation) {\n      navigator.geolocation.getCurrentPosition(\n        (pos) => setLocation([pos.coords.latitude, pos.coords.longitude]),\n        (err) => {\n          console.warn(\'Geolocation declined or timed out:\', err);\n        },\n        { timeout: 4000 }\n      );\n    }\n    fetchIssues();\n    fetchProjects();\n  }, []);\n\n  const fetchIssues = async () => {\n    try {\n      const res = await fetch(\'/api/issues\');\n      const data = await res.json();\n      setIssues(data);\n    } catch (e) {\n      console.error(e);\n    }\n  };\n\n  const fetchProjects = async () => {\n    try {\n      const res = await fetch(\'/api/projects\');\n      const data = await res.json();\n      setProjects(data);\n    } catch (e) {\n      console.error(e);\n    }\n  };\n\n  const handleUpvoteIssue = async (id: string) => {\n    try {\n      await fetch(`/api/issues/${id}/upvote`, { method: \'POST\' });\n      fetchIssues(); // Refresh list\n    } catch (e) {\n      console.error(e);\n    }\n  };\n\n  const handleUpvoteProject = async (id: string, isPositive: boolean) => {\n    // We haven\'t built the api for this yet, so we\'ll just mock it or wait for server changes\n    // Wait, let\'s create a server.ts patch for it.\n    try {\n      await fetch(`/api/projects/${id}/vote`, { \n        method: \'POST\', \n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ isPositive }) \n      });\n      fetchProjects();\n    } catch (e) {\n      console.error(e);\n    }\n  };"
      replacement_content: "export default function CitizenDashboard({ language }: { language: string }) {\n  const [location, setLocation] = useState<[number, number]>([12.687, 78.615]);\n  const [issues, setIssues] = useState<any[]>([]);\n  const [projects, setProjects] = useState<any[]>([]);\n  const [activeTab, setActiveTab] = useState<\'feed\' | \'map\'>(\'feed\');\n\n  useEffect(() => {\n    // Generate simple local citizen ID if not present\n    let cid = localStorage.getItem(\'civic_reporter_user_id\');\n    if (!cid) {\n      cid = \'cit_\' + Math.floor(Math.random() * 1000000);\n      localStorage.setItem(\'civic_reporter_user_id\', cid);\n    }\n\n    if (navigator.geolocation) {\n      navigator.geolocation.getCurrentPosition(\n        (pos) => setLocation([pos.coords.latitude, pos.coords.longitude]),\n        (err) => {\n          console.warn(\'Geolocation declined or timed out:\', err);\n        },\n        { timeout: 4000 }\n      );\n    }\n    fetchIssues();\n    fetchProjects();\n  }, []);\n\n  const fetchIssues = async () => {\n    try {\n      const res = await fetch(\'/api/issues\');\n      const data = await res.json();\n      setIssues(data);\n    } catch (e) {\n      console.error(e);\n    }\n  };\n\n  const fetchProjects = async () => {\n    try {\n      const res = await fetch(\'/api/projects\');\n      const data = await res.json();\n      setProjects(data);\n    } catch (e) {\n      console.error(e);\n    }\n  };\n\n  const handleUpvoteIssue = async (id: string) => {\n    try {\n      const userId = localStorage.getItem(\'civic_reporter_user_id\') || \'anonymous_user\';\n      await fetch(`/api/issues/${id}/upvote`, { \n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ userId })\n      });\n      fetchIssues(); // Refresh list\n    } catch (e) {\n      console.error(e);\n    }\n  };\n\n  const handleUpvoteProject = async (id: string, isPositive: boolean) => {\n    try {\n      const userId = localStorage.getItem(\'civic_reporter_user_id\') || \'anonymous_user\';\n      await fetch(`/api/projects/${id}/vote`, { \n        method: \'POST\', \n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ isPositive, userId }) \n      });\n      fetchProjects();\n    } catch (e) {\n      console.error(e);\n    }\n  };"
    }
