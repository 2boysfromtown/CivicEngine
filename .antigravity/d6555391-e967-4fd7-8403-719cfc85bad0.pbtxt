    command_line: "cat << \'EOF\' > src/components/CitizenDashboard.tsx\nimport React, { useState, useEffect } from \'react\';\nimport VoiceReporter from \'./VoiceReporter\';\nimport { MapContainer, TileLayer, Marker, Popup, useMap } from \'react-leaflet\';\nimport \'leaflet/dist/leaflet.css\';\nimport L from \'leaflet\';\nimport { ThumbsUp, MapPin, TrendingUp, MessageSquare, AlertTriangle, Building } from \'lucide-react\';\nimport { cn } from \'../lib/utils\';\nimport { t } from \'../i18n\';\n\n// Fix leaflet icon\ndelete (L.Icon.Default.prototype as any)._getIconUrl;\nL.Icon.Default.mergeOptions({\n  iconRetinaUrl: \'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.7.1/images/marker-icon-2x.png\',\n  iconUrl: \'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.7.1/images/marker-icon.png\',\n  shadowUrl: \'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.7.1/images/marker-shadow.png\',\n});\n\nfunction ChangeView({ center }: { center: [number, number] }) {\n  const map = useMap();\n  map.setView(center, 15);\n  return null;\n}\n\nexport default function CitizenDashboard({ language }: { language: string }) {\n  const [location, setLocation] = useState<[number, number] | null>(null);\n  const [issues, setIssues] = useState<any[]>([]);\n  const [projects, setProjects] = useState<any[]>([]);\n  const [activeTab, setActiveTab] = useState<\'feed\' | \'map\'>(\'feed\');\n\n  useEffect(() => {\n    navigator.geolocation.getCurrentPosition(\n      (pos) => setLocation([pos.coords.latitude, pos.coords.longitude]),\n      (err) => {\n        console.error(err);\n        // default fallback location to ensure map shows something\n        setLocation([12.687, 78.615]);\n      }\n    );\n    fetchIssues();\n    fetchProjects();\n  }, []);\n\n  const fetchIssues = async () => {\n    try {\n      const res = await fetch(\'/api/issues\');\n      const data = await res.json();\n      setIssues(data);\n    } catch (e) {\n      console.error(e);\n    }\n  };\n\n  const fetchProjects = async () => {\n    try {\n      const res = await fetch(\'/api/projects\');\n      const data = await res.json();\n      setProjects(data);\n    } catch (e) {\n      console.error(e);\n    }\n  };\n\n  const handleUpvoteIssue = async (id: string) => {\n    try {\n      await fetch(`/api/issues/${id}/upvote`, { method: \'POST\' });\n      fetchIssues(); // Refresh list\n    } catch (e) {\n      console.error(e);\n    }\n  };\n\n  const handleUpvoteProject = async (id: string, isPositive: boolean) => {\n    // We haven\'t built the api for this yet, so we\'ll just mock it or wait for server changes\n    // Wait, let\'s create a server.ts patch for it.\n    try {\n      await fetch(`/api/projects/${id}/vote`, { \n        method: \'POST\', \n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ isPositive }) \n      });\n      fetchProjects();\n    } catch (e) {\n      console.error(e);\n    }\n  };\n\n  const sortedIssues = [...issues].sort((a, b) => b.priority_score - a.priority_score);\n\n  return (\n    <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 pb-20 md:pb-0\">\n      \n      {/* Left Column: Voice Reporter (Mobile fixed bottom or in flow) */}\n      <div className=\"lg:col-span-3 order-first lg:order-none\">\n        <div className=\"sticky top-20\">\n          <VoiceReporter language={language} location={location} onReportSubmitted={fetchIssues} />\n        </div>\n      </div>\n\n      {/* Center Column: Feed */}\n      <div className=\"lg:col-span-5 flex flex-col gap-4\">\n        {/* Mobile Tabs */}\n        <div className=\"flex lg:hidden bg-white p-1 rounded-xl shadow-sm border border-sandalwood-200 mb-2\">\n          <button \n            className={cn(\"flex-1 py-2 text-sm font-bold rounded-lg transition-colors\", activeTab === \'feed\' ? \"bg-black text-white\" : \"text-sandalwood-600\")}\n            onClick={() => setActiveTab(\'feed\')}\n          >\n            {t(language, \'feed\')}\n          </button>\n          <button \n            className={cn(\"flex-1 py-2 text-sm font-bold rounded-lg transition-colors\", activeTab === \'map\' ? \"bg-black text-white\" : \"text-sandalwood-600\")}\n            onClick={() => setActiveTab(\'map\')}\n          >\n            Map View\n          </button>\n        </div>\n\n        <div className={cn(\"flex-col gap-6\", activeTab === \'feed\' ? \'flex\' : \'hidden lg:flex\')}>\n          <div className=\"flex items-center justify-between border-b-2 border-black pb-2\">\n            <h2 className=\"text-xl font-bold flex items-center gap-2\">\n              <TrendingUp size={20} /> Local Feed\n            </h2>\n          </div>\n\n          <div className=\"space-y-4\">\n            {sortedIssues.map(issue => (\n              <div key={issue.issue_id} className=\"bg-white rounded-xl shadow-sm border border-sandalwood-200 overflow-hidden flex\">\n                {/* Vote column */}\n                <div className=\"w-12 bg-sandalwood-50 flex flex-col items-center py-4 border-r border-sandalwood-100 shrink-0\">\n                  <button onClick={() => handleUpvoteIssue(issue.issue_id)} className=\"text-sandalwood-500 hover:text-black transition-colors p-1\">\n                    <ThumbsUp size={18} />\n                  </button>\n                  <span className=\"font-bold text-sm my-1\">{issue.citizen_upvote_count}</span>\n                </div>\n                \n                {/* Content */}\n                <div className=\"p-4 flex-1\">\n                  <div className=\"flex justify-between items-start mb-2\">\n                    <span className=\"text-xs font-bold text-sandalwood-700 bg-sandalwood-100 px-2 py-0.5 rounded flex items-center gap-1\">\n                      <AlertTriangle size={12} /> {issue.category}\n                    </span>\n                    <span className=\"text-xs font-medium text-sandalwood-500\">\n                      {new Date(issue.created_at).toLocaleDateString()}\n                    </span>\n                  </div>\n                  <h3 className=\"font-medium text-black text-sm md:text-base leading-snug mb-2\">{issue.executive_summary}</h3>\n                  <div className=\"flex gap-4 text-xs font-medium text-sandalwood-500 mt-3 pt-3 border-t border-sandalwood-100\">\n                    <div className=\"flex items-center gap-1\"><MessageSquare size={14} /> 0 {t(language, \'comments\')}</div>\n                    <div className=\"flex items-center gap-1 text-red-600 bg-red-50 px-1.5 rounded\">{t(language, \'severity\')} {issue.severity_score}</div>\n                  </div>\n                </div>\n              </div>\n            ))}\n          </div>\n\n          <div className=\"flex items-center justify-between border-b-2 border-black pb-2 mt-4\">\n            <h2 className=\"text-xl font-bold flex items-center gap-2\">\n              <Building size={20} /> {t(language, \'projects\')}\n            </h2>\n          </div>\n          \n          <div className=\"space-y-4\">\n            {projects.map(proj => (\n              <div key={proj.project_id} className=\"bg-white rounded-xl shadow-sm border border-sandalwood-200 overflow-hidden p-4\">\n                <div className=\"flex justify-between items-start mb-2\">\n                  <span className=\"text-xs font-bold text-blue-700 bg-blue-50 px-2 py-0.5 rounded border border-blue-100\">\n                    {proj.department}\n                  </span>\n                  <div className=\"flex gap-2\">\n                     <button onClick={() => handleUpvoteProject(proj.project_id, true)} className=\"flex items-center gap-1 text-xs font-bold bg-sandalwood-100 hover:bg-sandalwood-200 px-2 py-1 rounded transition-colors\">\n                       <ThumbsUp size={14} /> {proj.sentiment_summary.positive_votes}\n                     </button>\n                  </div>\n                </div>\n                <h3 className=\"font-bold text-lg mb-1\">{proj.title}</h3>\n                <p className=\"text-sm text-sandalwood-700 mb-3\">{proj.sentiment_summary.top_criticism_theme ? `Latest feedback: \"${proj.sentiment_summary.top_criticism_theme}\"` : \"No public feedback yet.\"}</p>\n                \n                <div className=\"w-full bg-sandalwood-100 h-2 rounded-full overflow-hidden flex\">\n                  <div className=\"bg-black h-full\" style={{ width: `${(proj.sentiment_summary.positive_votes / Math.max(1, (proj.sentiment_summary.positive_votes + proj.sentiment_summary.negative_criticisms))) * 100}%` }}></div>\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n      </div>\n\n      {/* Right Column: Map */}\n      <div className={cn(\"lg:col-span-4\", activeTab === \'map\' ? \'block\' : \'hidden lg:block\')}>\n        <div className=\"sticky top-20 bg-white rounded-2xl shadow-sm border border-sandalwood-200 overflow-hidden flex flex-col h-[400px] lg:h-[600px]\">\n          <div className=\"p-3 border-b border-sandalwood-200 bg-black text-white flex items-center justify-between\">\n            <h2 className=\"font-bold flex items-center gap-2 text-sm\">\n              <MapPin size={16} /> {t(language, \'nearbyIssues\')}\n            </h2>\n            <span className=\"text-xs font-bold bg-white text-black px-2 py-0.5 rounded\">\n              {issues.length} {t(language, \'active\')}\n            </span>\n          </div>\n          <div className=\"flex-1 relative z-0\">\n            {location ? (\n              <MapContainer center={location} zoom={13} style={{ height: \'100%\', width: \'100%\' }}>\n                <TileLayer\n                  url=\"https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png\"\n                  attribution=\'&copy; <a href=\"https://carto.com/\">CARTO</a>\'\n                />\n                <ChangeView center={location} />\n                \n                <Marker position={location}>\n                  <Popup>{t(language, \'youAreHere\')}</Popup>\n                </Marker>\n\n                {issues.filter(i => i.coordinates?.latitude && i.coordinates?.longitude).map((issue) => (\n                  <Marker \n                    key={issue.issue_id} \n                    position={[issue.coordinates.latitude, issue.coordinates.longitude]}\n                  >\n                    <Popup>\n                      <div className=\"w-48\">\n                        <div className=\"font-bold text-sm mb-1\">{issue.category}</div>\n                        <p className=\"text-xs text-sandalwood-700 mb-2\">{issue.executive_summary}</p>\n                        <div className=\"flex items-center justify-between mt-2\">\n                          <span className=\"text-xs font-bold text-red-600 bg-red-50 px-2 py-0.5 rounded\">Sev {issue.severity_score}</span>\n                          <span className=\"flex items-center gap-1 text-xs font-bold bg-black text-white px-2 py-1 rounded\">\n                            <ThumbsUp size={12} /> {issue.citizen_upvote_count}\n                          </span>\n                        </div>\n                      </div>\n                    </Popup>\n                  </Marker>\n                ))}\n              </MapContainer>\n            ) : (\n              <div className=\"w-full h-full flex items-center justify-center bg-sandalwood-100 text-sandalwood-600 font-medium\">\n                {t(language, \'locating\')}\n              </div>\n            )}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\nEOF"
    proposed_command_line: "cat << \'EOF\' > src/components/CitizenDashboard.tsx\nimport React, { useState, useEffect } from \'react\';\nimport VoiceReporter from \'./VoiceReporter\';\nimport { MapContainer, TileLayer, Marker, Popup, useMap } from \'react-leaflet\';\nimport \'leaflet/dist/leaflet.css\';\nimport L from \'leaflet\';\nimport { ThumbsUp, MapPin, TrendingUp, MessageSquare, AlertTriangle, Building } from \'lucide-react\';\nimport { cn } from \'../lib/utils\';\nimport { t } from \'../i18n\';\n\n// Fix leaflet icon\ndelete (L.Icon.Default.prototype as any)._getIconUrl;\nL.Icon.Default.mergeOptions({\n  iconRetinaUrl: \'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.7.1/images/marker-icon-2x.png\',\n  iconUrl: \'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.7.1/images/marker-icon.png\',\n  shadowUrl: \'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.7.1/images/marker-shadow.png\',\n});\n\nfunction ChangeView({ center }: { center: [number, number] }) {\n  const map = useMap();\n  map.setView(center, 15);\n  return null;\n}\n\nexport default function CitizenDashboard({ language }: { language: string }) {\n  const [location, setLocation] = useState<[number, number] | null>(null);\n  const [issues, setIssues] = useState<any[]>([]);\n  const [projects, setProjects] = useState<any[]>([]);\n  const [activeTab, setActiveTab] = useState<\'feed\' | \'map\'>(\'feed\');\n\n  useEffect(() => {\n    navigator.geolocation.getCurrentPosition(\n      (pos) => setLocation([pos.coords.latitude, pos.coords.longitude]),\n      (err) => {\n        console.error(err);\n        // default fallback location to ensure map shows something\n        setLocation([12.687, 78.615]);\n      }\n    );\n    fetchIssues();\n    fetchProjects();\n  }, []);\n\n  const fetchIssues = async () => {\n    try {\n      const res = await fetch(\'/api/issues\');\n      const data = await res.json();\n      setIssues(data);\n    } catch (e) {\n      console.error(e);\n    }\n  };\n\n  const fetchProjects = async () => {\n    try {\n      const res = await fetch(\'/api/projects\');\n      const data = await res.json();\n      setProjects(data);\n    } catch (e) {\n      console.error(e);\n    }\n  };\n\n  const handleUpvoteIssue = async (id: string) => {\n    try {\n      await fetch(`/api/issues/${id}/upvote`, { method: \'POST\' });\n      fetchIssues(); // Refresh list\n    } catch (e) {\n      console.error(e);\n    }\n  };\n\n  const handleUpvoteProject = async (id: string, isPositive: boolean) => {\n    // We haven\'t built the api for this yet, so we\'ll just mock it or wait for server changes\n    // Wait, let\'s create a server.ts patch for it.\n    try {\n      await fetch(`/api/projects/${id}/vote`, { \n        method: \'POST\', \n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ isPositive }) \n      });\n      fetchProjects();\n    } catch (e) {\n      console.error(e);\n    }\n  };\n\n  const sortedIssues = [...issues].sort((a, b) => b.priority_score - a.priority_score);\n\n  return (\n    <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 pb-20 md:pb-0\">\n      \n      {/* Left Column: Voice Reporter (Mobile fixed bottom or in flow) */}\n      <div className=\"lg:col-span-3 order-first lg:order-none\">\n        <div className=\"sticky top-20\">\n          <VoiceReporter language={language} location={location} onReportSubmitted={fetchIssues} />\n        </div>\n      </div>\n\n      {/* Center Column: Feed */}\n      <div className=\"lg:col-span-5 flex flex-col gap-4\">\n        {/* Mobile Tabs */}\n        <div className=\"flex lg:hidden bg-white p-1 rounded-xl shadow-sm border border-sandalwood-200 mb-2\">\n          <button \n            className={cn(\"flex-1 py-2 text-sm font-bold rounded-lg transition-colors\", activeTab === \'feed\' ? \"bg-black text-white\" : \"text-sandalwood-600\")}\n            onClick={() => setActiveTab(\'feed\')}\n          >\n            {t(language, \'feed\')}\n          </button>\n          <button \n            className={cn(\"flex-1 py-2 text-sm font-bold rounded-lg transition-colors\", activeTab === \'map\' ? \"bg-black text-white\" : \"text-sandalwood-600\")}\n            onClick={() => setActiveTab(\'map\')}\n          >\n            Map View\n          </button>\n        </div>\n\n        <div className={cn(\"flex-col gap-6\", activeTab === \'feed\' ? \'flex\' : \'hidden lg:flex\')}>\n          <div className=\"flex items-center justify-between border-b-2 border-black pb-2\">\n            <h2 className=\"text-xl font-bold flex items-center gap-2\">\n              <TrendingUp size={20} /> Local Feed\n            </h2>\n          </div>\n\n          <div className=\"space-y-4\">\n            {sortedIssues.map(issue => (\n              <div key={issue.issue_id} className=\"bg-white rounded-xl shadow-sm border border-sandalwood-200 overflow-hidden flex\">\n                {/* Vote column */}\n                <div className=\"w-12 bg-sandalwood-50 flex flex-col items-center py-4 border-r border-sandalwood-100 shrink-0\">\n                  <button onClick={() => handleUpvoteIssue(issue.issue_id)} className=\"text-sandalwood-500 hover:text-black transition-colors p-1\">\n                    <ThumbsUp size={18} />\n                  </button>\n                  <span className=\"font-bold text-sm my-1\">{issue.citizen_upvote_count}</span>\n                </div>\n                \n                {/* Content */}\n                <div className=\"p-4 flex-1\">\n                  <div className=\"flex justify-between items-start mb-2\">\n                    <span className=\"text-xs font-bold text-sandalwood-700 bg-sandalwood-100 px-2 py-0.5 rounded flex items-center gap-1\">\n                      <AlertTriangle size={12} /> {issue.category}\n                    </span>\n                    <span className=\"text-xs font-medium text-sandalwood-500\">\n                      {new Date(issue.created_at).toLocaleDateString()}\n                    </span>\n                  </div>\n                  <h3 className=\"font-medium text-black text-sm md:text-base leading-snug mb-2\">{issue.executive_summary}</h3>\n                  <div className=\"flex gap-4 text-xs font-medium text-sandalwood-500 mt-3 pt-3 border-t border-sandalwood-100\">\n                    <div className=\"flex items-center gap-1\"><MessageSquare size={14} /> 0 {t(language, \'comments\')}</div>\n                    <div className=\"flex items-center gap-1 text-red-600 bg-red-50 px-1.5 rounded\">{t(language, \'severity\')} {issue.severity_score}</div>\n                  </div>\n                </div>\n              </div>\n            ))}\n          </div>\n\n          <div className=\"flex items-center justify-between border-b-2 border-black pb-2 mt-4\">\n            <h2 className=\"text-xl font-bold flex items-center gap-2\">\n              <Building size={20} /> {t(language, \'projects\')}\n            </h2>\n          </div>\n          \n          <div className=\"space-y-4\">\n            {projects.map(proj => (\n              <div key={proj.project_id} className=\"bg-white rounded-xl shadow-sm border border-sandalwood-200 overflow-hidden p-4\">\n                <div className=\"flex justify-between items-start mb-2\">\n                  <span className=\"text-xs font-bold text-blue-700 bg-blue-50 px-2 py-0.5 rounded border border-blue-100\">\n                    {proj.department}\n                  </span>\n                  <div className=\"flex gap-2\">\n                     <button onClick={() => handleUpvoteProject(proj.project_id, true)} className=\"flex items-center gap-1 text-xs font-bold bg-sandalwood-100 hover:bg-sandalwood-200 px-2 py-1 rounded transition-colors\">\n                       <ThumbsUp size={14} /> {proj.sentiment_summary.positive_votes}\n                     </button>\n                  </div>\n                </div>\n                <h3 className=\"font-bold text-lg mb-1\">{proj.title}</h3>\n                <p className=\"text-sm text-sandalwood-700 mb-3\">{proj.sentiment_summary.top_criticism_theme ? `Latest feedback: \"${proj.sentiment_summary.top_criticism_theme}\"` : \"No public feedback yet.\"}</p>\n                \n                <div className=\"w-full bg-sandalwood-100 h-2 rounded-full overflow-hidden flex\">\n                  <div className=\"bg-black h-full\" style={{ width: `${(proj.sentiment_summary.positive_votes / Math.max(1, (proj.sentiment_summary.positive_votes + proj.sentiment_summary.negative_criticisms))) * 100}%` }}></div>\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n      </div>\n\n      {/* Right Column: Map */}\n      <div className={cn(\"lg:col-span-4\", activeTab === \'map\' ? \'block\' : \'hidden lg:block\')}>\n        <div className=\"sticky top-20 bg-white rounded-2xl shadow-sm border border-sandalwood-200 overflow-hidden flex flex-col h-[400px] lg:h-[600px]\">\n          <div className=\"p-3 border-b border-sandalwood-200 bg-black text-white flex items-center justify-between\">\n            <h2 className=\"font-bold flex items-center gap-2 text-sm\">\n              <MapPin size={16} /> {t(language, \'nearbyIssues\')}\n            </h2>\n            <span className=\"text-xs font-bold bg-white text-black px-2 py-0.5 rounded\">\n              {issues.length} {t(language, \'active\')}\n            </span>\n          </div>\n          <div className=\"flex-1 relative z-0\">\n            {location ? (\n              <MapContainer center={location} zoom={13} style={{ height: \'100%\', width: \'100%\' }}>\n                <TileLayer\n                  url=\"https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png\"\n                  attribution=\'&copy; <a href=\"https://carto.com/\">CARTO</a>\'\n                />\n                <ChangeView center={location} />\n                \n                <Marker position={location}>\n                  <Popup>{t(language, \'youAreHere\')}</Popup>\n                </Marker>\n\n                {issues.filter(i => i.coordinates?.latitude && i.coordinates?.longitude).map((issue) => (\n                  <Marker \n                    key={issue.issue_id} \n                    position={[issue.coordinates.latitude, issue.coordinates.longitude]}\n                  >\n                    <Popup>\n                      <div className=\"w-48\">\n                        <div className=\"font-bold text-sm mb-1\">{issue.category}</div>\n                        <p className=\"text-xs text-sandalwood-700 mb-2\">{issue.executive_summary}</p>\n                        <div className=\"flex items-center justify-between mt-2\">\n                          <span className=\"text-xs font-bold text-red-600 bg-red-50 px-2 py-0.5 rounded\">Sev {issue.severity_score}</span>\n                          <span className=\"flex items-center gap-1 text-xs font-bold bg-black text-white px-2 py-1 rounded\">\n                            <ThumbsUp size={12} /> {issue.citizen_upvote_count}\n                          </span>\n                        </div>\n                      </div>\n                    </Popup>\n                  </Marker>\n                ))}\n              </MapContainer>\n            ) : (\n              <div className=\"w-full h-full flex items-center justify-center bg-sandalwood-100 text-sandalwood-600 font-medium\">\n                {t(language, \'locating\')}\n              </div>\n            )}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\nEOF"
