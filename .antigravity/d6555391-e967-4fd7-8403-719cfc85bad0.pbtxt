      target_content: "import { useEffect, useState } from \'react\';\nimport { Issue, Project } from \'../types\';\nimport { AlertTriangle, MapPin, TrendingDown, TrendingUp, Clock, CheckCircle } from \'lucide-react\';\nimport { clsx, type ClassValue } from \'clsx\';\nimport { twMerge } from \'tailwind-merge\';\n\nfunction cn(...inputs: ClassValue[]) {\n  return twMerge(clsx(inputs));\n}\n\nexport default function AuthorityDashboard() {\n  const [issues, setIssues] = useState<Issue[]>([]);\n  const [projects, setProjects] = useState<Project[]>([]);\n  const [loading, setLoading] = useState(true);\n\n  const fetchData = async () => {\n    try {\n      const [issuesRes, projectsRes] = await Promise.all([\n        fetch(\'/api/issues\'),\n        fetch(\'/api/projects\')\n      ]);\n      const issuesData = await issuesRes.json();\n      const projectsData = await projectsRes.json();\n      \n      // Sort issues by priority_score descending\n      const sortedIssues = issuesData.sort((a: Issue, b: Issue) => b.priority_score - a.priority_score);\n      setIssues(sortedIssues);\n      setProjects(projectsData);\n    } catch (err) {\n      console.error(\'Failed to load dashboard data\', err);\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  useEffect(() => {\n    fetchData();\n    // Poll every 10 seconds for live updates\n    const interval = setInterval(fetchData, 10000);\n    return () => clearInterval(interval);\n  }, []);\n\n  if (loading) {\n    return (\n      <div className=\"flex items-center justify-center h-full w-full bg-slate-950 text-slate-400\">\n        <span className=\"animate-pulse tracking-widest text-sm font-mono\">INITIALIZING DASHBOARD...</span>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"min-h-screen bg-slate-950 text-slate-200 p-6 font-sans selection:bg-indigo-500/30\">\n      <header className=\"mb-8 flex items-center justify-between border-b border-slate-800 pb-6\">\n        <div>\n          <h1 className=\"text-3xl font-bold tracking-tight text-white flex items-center gap-3\">\n            <div className=\"w-3 h-3 rounded-full bg-emerald-500 animate-pulse shadow-[0_0_15px_rgba(16,185,129,0.5)]\" />\n            Civic Command Center\n          </h1>\n          <p className=\"text-slate-400 mt-1 text-sm font-medium\">Real-time Multimodal Intake & Priority Engine</p>\n        </div>\n        <div className=\"text-right\">\n          <p className=\"text-xs font-mono text-slate-500 uppercase tracking-widest\">Active Nodes</p>\n          <p className=\"text-xl font-bold font-mono text-indigo-400\">{issues.length}</p>\n        </div>\n      </header>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        \n        {/* Left Column: Heatmap & Projects */}\n        <div className=\"lg:col-span-2 space-y-6\">\n          \n          {/* Mock Heatmap */}\n          <div className=\"bg-slate-900 rounded-2xl border border-slate-800 overflow-hidden shadow-lg relative\">\n            <div className=\"p-4 border-b border-slate-800 bg-slate-900/50 flex justify-between items-center\">\n              <h2 className=\"text-lg font-semibold flex items-center gap-2\">\n                <MapPin size={18} className=\"text-indigo-400\" /> \n                Macro Command Heatmap\n              </h2>\n              <span className=\"text-xs bg-indigo-500/10 text-indigo-400 px-2 py-1 rounded-md font-mono\">LIVE GEO-CLUSTERING</span>\n            </div>\n            <div className=\"h-[300px] w-full bg-slate-950 relative overflow-hidden flex items-center justify-center pattern-grid\">\n              {/* Simulated map background styling via grid pattern - we just use CSS */}\n              <div className=\"absolute inset-0 opacity-10 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-indigo-500/30 via-slate-950 to-slate-950\" />\n              \n              {/* Plotting points randomly or by lat/lng roughly */}\n              {issues.map((issue, idx) => {\n                // Rough coordinate mapping for a static mock view\n                const top = 20 + ((idx * 37) % 60);\n                const left = 20 + ((idx * 61) % 60);\n                const isCritical = issue.priority_score > 6;\n                return (\n                  <div \n                    key={issue.issue_id} \n                    className={cn(\n                      \"absolute rounded-full transform -translate-x-1/2 -translate-y-1/2 cursor-pointer transition-all hover:scale-150\",\n                      isCritical ? \"bg-red-500 shadow-[0_0_20px_rgba(239,68,68,0.7)]\" : \"bg-amber-500 shadow-[0_0_15px_rgba(245,158,11,0.5)]\"\n                    )}\n                    style={{\n                      top: `${top}%`,\n                      left: `${left}%`,\n                      width: `${Math.max(10, issue.priority_score * 2)}px`,\n                      height: `${Math.max(10, issue.priority_score * 2)}px`,\n                      opacity: 0.8\n                    }}\n                    title={issue.category}\n                  />\n                );\n              })}\n              \n              {!issues.length && (\n                 <span className=\"text-slate-600 font-mono text-sm\">NO ACTIVE NODES DETECTED</span>\n              )}\n            </div>\n          </div>\n\n          {/* Project Sentiment Monitor */}\n          <div className=\"bg-slate-900 rounded-2xl border border-slate-800 overflow-hidden shadow-lg\">\n             <div className=\"p-4 border-b border-slate-800 flex justify-between items-center\">\n              <h2 className=\"text-lg font-semibold flex items-center gap-2\">\n                <TrendingUp size={18} className=\"text-emerald-400\" /> \n                Project Public Sentiment Monitor\n              </h2>\n            </div>\n            <div className=\"p-4 space-y-4\">\n              {projects.map(proj => (\n                <div key={proj.project_id} className=\"bg-slate-950 p-4 rounded-xl border border-slate-800\">\n                  <div className=\"flex justify-between items-start mb-2\">\n                    <div>\n                      <h3 className=\"font-semibold text-white\">{proj.title}</h3>\n                      <p className=\"text-xs text-slate-400 font-mono\">{proj.project_id} \342\200\242 {proj.department}</p>\n                    </div>\n                    <div className={cn(\n                      \"flex items-center gap-1 text-sm font-bold px-2 py-1 rounded\",\n                      proj.sentiment_summary.ai_sentiment_index >= 0 ? \"bg-emerald-500/10 text-emerald-400\" : \"bg-red-500/10 text-red-400\"\n                    )}>\n                      {proj.sentiment_summary.ai_sentiment_index >= 0 ? <TrendingUp size={16} /> : <TrendingDown size={16} />}\n                      {proj.sentiment_summary.ai_sentiment_index > 0 ? \'+\' : \'\'}{proj.sentiment_summary.ai_sentiment_index.toFixed(2)}\n                    </div>\n                  </div>\n                  \n                  <div className=\"mt-4 text-sm bg-slate-900 p-3 rounded-lg text-slate-300 border border-slate-800\">\n                    <span className=\"text-xs font-bold text-slate-500 uppercase tracking-wider block mb-1\">Top Criticism Theme</span>\n                    \"{proj.sentiment_summary.top_criticism_theme}\"\n                  </div>\n                  \n                  <div className=\"mt-3 flex gap-4 text-xs font-mono text-slate-500\">\n                     <span>POSITIVE: {proj.sentiment_summary.positive_votes}</span>\n                     <span>NEGATIVE: {proj.sentiment_summary.negative_criticisms}</span>\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n\n        </div>\n\n        {/* Right Column: Execution Queue */}\n        <div className=\"space-y-6\">\n          <div className=\"bg-slate-900 rounded-2xl border border-slate-800 overflow-hidden shadow-lg h-full flex flex-col\">\n            <div className=\"p-4 border-b border-slate-800 flex justify-between items-center bg-red-500/5\">\n              <h2 className=\"text-lg font-semibold flex items-center gap-2 text-red-100\">\n                <AlertTriangle size={18} className=\"text-red-500\" /> \n                High-Priority Execution Queue\n              </h2>\n            </div>\n            \n            <div className=\"p-4 overflow-y-auto flex-1 space-y-3\">\n              {issues.length === 0 ? (\n                <div className=\"text-center text-slate-500 text-sm py-8\">Queue is clear.</div>\n              ) : (\n                issues.map((issue) => (\n                  <div \n                    key={issue.issue_id} \n                    className={cn(\n                      \"p-4 rounded-xl border relative overflow-hidden transition-all\",\n                      issue.priority_score > 6 \n                        ? \"bg-red-950/20 border-red-900/50 hover:bg-red-900/30\" \n                        : \"bg-slate-950 border-slate-800 hover:bg-slate-800\"\n                    )}\n                  >\n                    {issue.priority_score > 6 && (\n                       <div className=\"absolute top-0 left-0 w-1 h-full bg-red-500\" />\n                    )}\n                    <div className=\"flex justify-between items-start mb-2\">\n                      <span className=\"text-xs font-mono bg-slate-800 px-2 py-1 rounded text-slate-300\">\n                        {issue.category}\n                      </span>\n                      <span className={cn(\n                        \"text-sm font-bold font-mono\",\n                        issue.priority_score > 6 ? \"text-red-400\" : \"text-amber-400\"\n                      )}>\n                        PRI: {issue.priority_score.toFixed(1)}\n                      </span>\n                    </div>\n                    <p className=\"text-sm text-slate-200 mt-2 line-clamp-3 leading-relaxed\">\n                      {issue.executive_summary}\n                    </p>\n                    <div className=\"mt-4 flex items-center justify-between text-xs text-slate-500 font-mono\">\n                      <div className=\"flex items-center gap-1\">\n                         <Clock size={14} />\n                         {new Date(issue.created_at).toLocaleDateString()}\n                      </div>\n                      <div className=\"flex items-center gap-1 text-indigo-400\">\n                        <CheckCircle size={14} />\n                        {issue.citizen_upvote_count} Upvotes\n                      </div>\n                    </div>\n                  </div>\n                ))\n              )}\n            </div>\n          </div>\n        </div>\n\n      </div>\n    </div>\n  );\n}"
      replacement_content: "import { useEffect, useState } from \'react\';\nimport { Issue, Project } from \'../types\';\nimport { AlertTriangle, MapPin, TrendingDown, TrendingUp, Clock, CheckCircle } from \'lucide-react\';\nimport { clsx, type ClassValue } from \'clsx\';\nimport { twMerge } from \'tailwind-merge\';\n\nfunction cn(...inputs: ClassValue[]) {\n  return twMerge(clsx(inputs));\n}\n\nexport default function AuthorityDashboard() {\n  const [issues, setIssues] = useState<Issue[]>([]);\n  const [projects, setProjects] = useState<Project[]>([]);\n  const [loading, setLoading] = useState(true);\n\n  const fetchData = async () => {\n    try {\n      const [issuesRes, projectsRes] = await Promise.all([\n        fetch(\'/api/issues\'),\n        fetch(\'/api/projects\')\n      ]);\n      const issuesData = await issuesRes.json();\n      const projectsData = await projectsRes.json();\n      \n      // Sort issues by priority_score descending\n      const sortedIssues = issuesData.sort((a: Issue, b: Issue) => b.priority_score - a.priority_score);\n      setIssues(sortedIssues);\n      setProjects(projectsData);\n    } catch (err) {\n      console.error(\'Failed to load dashboard data\', err);\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  useEffect(() => {\n    fetchData();\n    // Poll every 10 seconds for live updates\n    const interval = setInterval(fetchData, 10000);\n    return () => clearInterval(interval);\n  }, []);\n\n  if (loading) {\n    return (\n      <div className=\"flex items-center justify-center h-full w-full bg-sandalwood-50 text-sandalwood-600\">\n        <span className=\"animate-pulse tracking-widest text-sm font-mono\">INITIALIZING DASHBOARD...</span>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"bg-sandalwood-50 text-black font-sans\">\n      <header className=\"mb-8 flex items-center justify-between border-b border-sandalwood-200 pb-6\">\n        <div>\n          <h1 className=\"text-3xl font-bold tracking-tight text-black flex items-center gap-3\">\n            <div className=\"w-3 h-3 rounded-full bg-sandalwood-600 animate-pulse shadow-[0_0_15px_rgba(184,138,80,0.5)]\" />\n            Civic Command Center\n          </h1>\n          <p className=\"text-sandalwood-700 mt-1 text-sm font-medium\">Real-time Multimodal Intake & Priority Engine</p>\n        </div>\n        <div className=\"text-right\">\n          <p className=\"text-xs font-mono text-sandalwood-600 uppercase tracking-widest font-bold\">Active Nodes</p>\n          <p className=\"text-xl font-bold font-mono text-black\">{issues.length}</p>\n        </div>\n      </header>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        \n        {/* Left Column: Heatmap & Projects */}\n        <div className=\"lg:col-span-2 space-y-6\">\n          \n          {/* Mock Heatmap */}\n          <div className=\"bg-white rounded-2xl border border-sandalwood-200 overflow-hidden shadow-lg relative\">\n            <div className=\"p-4 border-b border-sandalwood-200 bg-white flex justify-between items-center\">\n              <h2 className=\"text-lg font-bold flex items-center gap-2 text-black\">\n                <MapPin size={18} className=\"text-sandalwood-600\" /> \n                Macro Command Heatmap\n              </h2>\n              <span className=\"text-xs bg-black text-white px-3 py-1 rounded-full font-mono font-bold tracking-wider\">LIVE GEO-CLUSTERING</span>\n            </div>\n            <div className=\"h-[300px] w-full bg-sandalwood-100 relative overflow-hidden flex items-center justify-center pattern-grid border-b border-sandalwood-200\">\n              {/* Simulated map background styling via grid pattern - we just use CSS */}\n              <div className=\"absolute inset-0 opacity-20 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-sandalwood-400 via-sandalwood-50 to-sandalwood-50\" />\n              \n              {/* Plotting points randomly or by lat/lng roughly */}\n              {issues.map((issue, idx) => {\n                // Rough coordinate mapping for a static mock view\n                const top = 20 + ((idx * 37) % 60);\n                const left = 20 + ((idx * 61) % 60);\n                const isCritical = issue.priority_score > 6;\n                return (\n                  <div \n                    key={issue.issue_id} \n                    className={cn(\n                      \"absolute rounded-full transform -translate-x-1/2 -translate-y-1/2 cursor-pointer transition-all hover:scale-150 border-2 border-white\",\n                      isCritical ? \"bg-black shadow-[0_0_20px_rgba(0,0,0,0.5)] z-20\" : \"bg-sandalwood-600 shadow-[0_0_15px_rgba(184,138,80,0.5)] z-10\"\n                    )}\n                    style={{\n                      top: `${top}%`,\n                      left: `${left}%`,\n                      width: `${Math.max(12, issue.priority_score * 2.5)}px`,\n                      height: `${Math.max(12, issue.priority_score * 2.5)}px`,\n                      opacity: 0.9\n                    }}\n                    title={issue.category}\n                  />\n                );\n              })}\n              \n              {!issues.length && (\n                 <span className=\"text-sandalwood-600 font-mono text-sm font-bold tracking-widest z-10\">NO ACTIVE NODES DETECTED</span>\n              )}\n            </div>\n          </div>\n\n          {/* Project Sentiment Monitor */}\n          <div className=\"bg-white rounded-2xl border border-sandalwood-200 overflow-hidden shadow-lg\">\n             <div className=\"p-4 border-b border-sandalwood-200 flex justify-between items-center bg-white\">\n              <h2 className=\"text-lg font-bold flex items-center gap-2 text-black\">\n                <TrendingUp size={18} className=\"text-sandalwood-600\" /> \n                Project Public Sentiment Monitor\n              </h2>\n            </div>\n            <div className=\"p-4 space-y-4\">\n              {projects.map(proj => (\n                <div key={proj.project_id} className=\"bg-sandalwood-50 p-5 rounded-xl border border-sandalwood-200\">\n                  <div className=\"flex justify-between items-start mb-2\">\n                    <div>\n                      <h3 className=\"font-bold text-black text-lg\">{proj.title}</h3>\n                      <p className=\"text-xs text-sandalwood-700 font-mono font-medium\">{proj.project_id} \342\200\242 {proj.department}</p>\n                    </div>\n                    <div className={cn(\n                      \"flex items-center gap-1 text-sm font-bold px-3 py-1.5 rounded-full border\",\n                      proj.sentiment_summary.ai_sentiment_index >= 0 ? \"bg-white text-black border-sandalwood-300\" : \"bg-black text-white border-black\"\n                    )}>\n                      {proj.sentiment_summary.ai_sentiment_index >= 0 ? <TrendingUp size={16} /> : <TrendingDown size={16} />}\n                      {proj.sentiment_summary.ai_sentiment_index > 0 ? \'+\' : \'\'}{proj.sentiment_summary.ai_sentiment_index.toFixed(2)}\n                    </div>\n                  </div>\n                  \n                  <div className=\"mt-4 text-sm bg-white p-4 rounded-lg text-black border border-sandalwood-200\">\n                    <span className=\"text-xs font-bold text-sandalwood-600 uppercase tracking-wider block mb-1\">Top Criticism Theme</span>\n                    <span className=\"font-medium italic\">\"{proj.sentiment_summary.top_criticism_theme}\"</span>\n                  </div>\n                  \n                  <div className=\"mt-4 flex gap-6 text-xs font-mono font-bold text-black border-t border-sandalwood-200 pt-3\">\n                     <span className=\"flex items-center gap-1\"><div className=\"w-2 h-2 rounded-full bg-sandalwood-400\"></div> POSITIVE: {proj.sentiment_summary.positive_votes}</span>\n                     <span className=\"flex items-center gap-1\"><div className=\"w-2 h-2 rounded-full bg-black\"></div> NEGATIVE: {proj.sentiment_summary.negative_criticisms}</span>\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n\n        </div>\n\n        {/* Right Column: Execution Queue */}\n        <div className=\"space-y-6\">\n          <div className=\"bg-white rounded-2xl border border-sandalwood-200 overflow-hidden shadow-lg h-full flex flex-col\">\n            <div className=\"p-4 border-b border-sandalwood-200 flex justify-between items-center bg-black\">\n              <h2 className=\"text-lg font-bold flex items-center gap-2 text-white\">\n                <AlertTriangle size={18} className=\"text-sandalwood-400\" /> \n                High-Priority Execution Queue\n              </h2>\n            </div>\n            \n            <div className=\"p-4 overflow-y-auto flex-1 space-y-4 bg-sandalwood-50\">\n              {issues.length === 0 ? (\n                <div className=\"text-center text-sandalwood-600 text-sm py-8 font-bold\">Queue is clear.</div>\n              ) : (\n                issues.map((issue) => (\n                  <div \n                    key={issue.issue_id} \n                    className={cn(\n                      \"p-5 rounded-xl border relative overflow-hidden transition-all shadow-sm\",\n                      issue.priority_score > 6 \n                        ? \"bg-white border-black hover:shadow-md\" \n                        : \"bg-white border-sandalwood-200 hover:border-sandalwood-400\"\n                    )}\n                  >\n                    {issue.priority_score > 6 && (\n                       <div className=\"absolute top-0 left-0 w-1.5 h-full bg-black\" />\n                    )}\n                    <div className=\"flex justify-between items-start mb-3\">\n                      <span className=\"text-xs font-bold font-mono bg-sandalwood-200 px-2.5 py-1 rounded-md text-black\">\n                        {issue.category}\n                      </span>\n                      <span className={cn(\n                        \"text-sm font-bold font-mono px-2 py-0.5 rounded\",\n                        issue.priority_score > 6 ? \"bg-black text-white\" : \"text-sandalwood-800 bg-sandalwood-100\"\n                      )}>\n                        PRI: {issue.priority_score.toFixed(1)}\n                      </span>\n                    </div>\n                    <p className=\"text-sm text-black mt-2 leading-relaxed font-medium\">\n                      {issue.executive_summary}\n                    </p>\n                    <div className=\"mt-5 flex items-center justify-between text-xs text-sandalwood-600 font-mono font-bold pt-3 border-t border-sandalwood-100\">\n                      <div className=\"flex items-center gap-1.5\">\n                         <Clock size={14} />\n                         {new Date(issue.created_at).toLocaleDateString()}\n                      </div>\n                      <div className=\"flex items-center gap-1.5 text-black\">\n                        <CheckCircle size={14} className=\"text-sandalwood-600\" />\n                        {issue.citizen_upvote_count} Upvotes\n                      </div>\n                    </div>\n                  </div>\n                ))\n              )}\n            </div>\n          </div>\n        </div>\n\n      </div>\n    </div>\n  );\n}"
    }
