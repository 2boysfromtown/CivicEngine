        replacement_content: "      {mode === \'step\' && step === 4 && (\n        <div className=\"z-10 flex flex-col items-center justify-center py-10 animate-in fade-in scale-in-95 duration-500\">\n          <CheckCircle2 size={64} className=\"text-black mb-4\" />\n          <h3 className=\"text-2xl font-bold text-black mb-2 tracking-tight text-center\">{texts.success}</h3>\n          <p className=\"text-sm text-sandalwood-700 mb-8 text-center font-medium\">Your report has been successfully logged and prioritized.</p>\n          <button \n            onClick={resetForm}\n            className=\"w-full py-3 bg-black text-white font-bold rounded-xl hover:bg-sandalwood-900 transition-colors shadow-md\"\n          >\n            {texts.again}\n          </button>\n        </div>\n      )}\n\n      {mode === \'manual\' && (\n        <div className=\"z-10 animate-in fade-in slide-in-from-right-4 duration-300 flex flex-col h-full\">\n          <h3 className=\"text-xl font-bold tracking-tight text-black mb-1 flex items-center gap-2\">\n            <Send size={18} className=\"text-sandalwood-600 animate-pulse\" /> {t(language, \'manualPost\')}\n          </h3>\n          <p className=\"text-xs text-sandalwood-700 font-medium mb-4\">{t(language, \'manualPostDesc\')}</p>\n\n          {manualSuccess ? (\n            <div className=\"flex flex-col items-center justify-center py-12 animate-in fade-in scale-in-95 duration-500\">\n              <CheckCircle2 size={56} className=\"text-black mb-3 animate-bounce\" />\n              <h4 className=\"text-lg font-bold text-black mb-1 text-center\">{t(language, \'reportLogged\')}</h4>\n              <p className=\"text-xs text-sandalwood-600 text-center font-medium\">Your issue has been posted directly to the feed!</p>\n            </div>\n          ) : (\n            <form onSubmit={handleManualSubmit} className=\"space-y-4\">\n              <div>\n                <label className=\"block text-xs font-bold text-black uppercase tracking-wider mb-1\">\n                  {t(language, \'category\')}\n                </label>\n                <select\n                  required\n                  value={manualCategory}\n                  onChange={(e) => setManualCategory(e.target.value)}\n                  className=\"w-full px-3 py-2 bg-sandalwood-50 border border-sandalwood-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-black text-xs font-bold text-black\"\n                >\n                  <option value=\"\">-- {t(language, \'selectCategory\')} --</option>\n                  <option value=\"ROADS\">\360\237\232\227 Roads / Potholes</option>\n                  <option value=\"WATER_SUPPLY\">\360\237\222\247 Water Supply</option>\n                  <option value=\"SANITATION\">\360\237\247\271 Sanitation / Trash</option>\n                  <option value=\"ELECTRICITY\">\342\232\241 Electricity / Streetlights</option>\n                  <option value=\"PUBLIC_SAFETY\">\360\237\233\241\357\270\217 Public Safety</option>\n                  <option value=\"OTHER\">\360\237\223\201 Other Issue</option>\n                </select>\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-bold text-black uppercase tracking-wider mb-1\">\n                  {t(language, \'summary\')}\n                </label>\n                <textarea\n                  required\n                  value={manualSummary}\n                  onChange={(e) => setManualSummary(e.target.value)}\n                  placeholder=\"Describe the issue clearly...\"\n                  className=\"w-full h-24 p-3 bg-sandalwood-50 border border-sandalwood-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-black text-xs resize-none text-black leading-relaxed font-medium\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-bold text-black uppercase tracking-wider mb-2 flex justify-between\">\n                  <span>{t(language, \'severityLevel\')}</span>\n                  <span className=\"font-mono font-bold bg-black text-white px-2 py-0.5 rounded text-[10px]\">\n                    {manualSeverity} / 5\n                  </span>\n                </label>\n                <div className=\"flex gap-2\">\n                  {[1, 2, 3, 4, 5].map((level) => (\n                    <button\n                      key={level}\n                      type=\"button\"\n                      onClick={() => setManualSeverity(level)}\n                      className={cn(\n                        \"flex-1 py-1.5 rounded-md text-xs font-bold transition-all border\",\n                        manualSeverity === level\n                          ? \"bg-black text-white border-black\"\n                          : \"bg-sandalwood-50 text-black border-sandalwood-200 hover:border-black\"\n                      )}\n                    >\n                      {level}\n                    </button>\n                  ))}\n                </div>\n              </div>\n\n              <button\n                type=\"submit\"\n                disabled={manualSubmitting || !manualCategory || !manualSummary.trim()}\n                className=\"w-full py-2.5 bg-black text-white text-xs font-bold rounded-lg hover:bg-sandalwood-900 transition-colors shadow-md flex items-center justify-center gap-1.5 disabled:opacity-50\"\n              >\n                {manualSubmitting ? (\n                  <>\n                    <Loader2 size={14} className=\"animate-spin\" />\n                    Posting...\n                  </>\n                ) : (\n                  <>\n                    <Send size={14} />\n                    {t(language, \'submitPost\')}\n                  </>\n                )}\n              </button>\n            </form>\n          )}\n        </div>\n      )}"
      }
      num_matches: 1
    }
  }
}
