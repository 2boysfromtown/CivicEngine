60\265\340\260\276\340\260\257\340\260\277\340\260\270\340\261\215 \340\260\217\340\260\234\340\261\206\340\260\202\340\260\237\340\261\215\", subtitle: \"\340\260\270\340\260\256\340\260\270\340\261\215\340\260\257\340\260\250\340\261\201 \340\260\232\340\261\206\340\260\252\340\261\215\340\260\252\340\260\241\340\260\276\340\260\250\340\260\277\340\260\225\340\260\277 \340\260\262\340\261\207\340\260\246\340\260\276 \340\260\225\340\261\212\340\260\250\340\260\270\340\260\276\340\260\227\340\261\201\340\260\244\340\261\201\340\260\250\340\261\215\340\260\250 \340\260\256\340\261\201\340\260\250\340\260\277\340\260\270\340\260\277\340\260\252\340\260\262\340\261\215 \340\260\252\340\261\215\340\260\260\340\260\276\340\260\234\340\261\206\340\260\225\340\261\215\340\260\237\340\261\215\342\200\214\340\260\250\340\261\201 \340\260\265\340\260\277\340\260\256\340\260\260\340\261\215\340\260\266\340\260\277\340\260\202\340\260\232\340\260\241\340\260\276\340\260\250\340\260\277\340\260\225\340\260\277 \340\260\260\340\260\277\340\260\225\340\260\276\340\260\260\340\261\215\340\260\241\340\261\215 \340\260\252\340\260\237\340\261\215\340\260\237\340\261\201\340\260\225\340\261\213\340\260\202\340\260\241\340\260\277.\", record: \"\340\260\260\340\260\277\340\260\225\340\260\276\340\260\260\340\261\215\340\260\241\340\261\215\", stop: \"\340\260\206\340\260\252\340\261\201\", analyzing: \"\340\260\265\340\260\277\340\260\266\340\261\215\340\260\262\340\261\207\340\260\267\340\260\277\340\260\270\340\261\215\340\260\244\340\261\213\340\260\202\340\260\246\340\260\277...\", success: \"\340\260\250\340\260\277\340\260\265\340\261\207\340\260\246\340\260\277\340\260\225 \340\260\270\340\261\201\340\260\260\340\260\225\340\261\215\340\260\267\340\260\277\340\260\244\340\260\202\340\260\227\340\260\276 \340\260\262\340\260\276\340\260\227\340\261\215 \340\260\232\340\261\207\340\260\257\340\260\254\340\260\241\340\260\277\340\260\202\340\260\246\340\260\277.\", again: \"\340\260\256\340\260\260\340\261\212\340\260\225 \340\260\270\340\260\256\340\260\270\340\261\215\340\260\257\340\260\250\340\261\201 \340\260\250\340\260\277\340\260\265\340\261\207\340\260\246\340\260\277\340\260\202\340\260\232\340\260\202\340\260\241\340\260\277\" }\n};\n\nexport default function VoiceReporter({ language = \'en\' }: { language?: string }) {\n  const [isRecording, setIsRecording] = useState(false);\n  const [uploading, setUploading] = useState(false);\n  const [success, setSuccess] = useState(false);\n  const mediaRecorderRef = useRef<MediaRecorder | null>(null);\n  const audioChunksRef = useRef<Blob[]>([]);\n  \n  const texts = LANG_MESSAGES[language] || LANG_MESSAGES.en;\n\n  const startRecording = async () => {\n    try {\n      setSuccess(false);\n      audioChunksRef.current = [];\n      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });\n      const mediaRecorder = new MediaRecorder(stream, { mimeType: \'audio/webm\' });\n      \n      mediaRecorder.ondataavailable = (event) => {\n        if (event.data.size > 0) audioChunksRef.current.push(event.data);\n      };\n\n      mediaRecorder.onstop = async () => {\n        const audioBlob = new Blob(audioChunksRef.current, { type: \'audio/webm\' });\n        await sendToCivicEngine(audioBlob);\n      };\n\n      mediaRecorderRef.current = mediaRecorder;\n      mediaRecorder.start();\n      setIsRecording(true);\n    } catch (err) {\n      console.error(\'Microphone access denied or error:\', err);\n      alert(\'Could not access microphone.\');\n    }\n  };\n\n  const stopRecording = () => {\n    if (mediaRecorderRef.current && isRecording) {\n      mediaRecorderRef.current.stop();\n      mediaRecorderRef.current.stream.getTracks().forEach(track => track.stop());\n      setIsRecording(false);\n    }\n  };\n\n  const sendToCivicEngine = async (audioBlob: Blob) => {\n    setUploading(true);\n    const formData = new FormData();\n    formData.append(\'audio\', audioBlob, \'report.webm\');\n    formData.append(\'language\', language);\n    \n    const sendData = async (lat: string, lng: string) => {\n      formData.append(\'lat\', lat);\n      formData.append(\'lng\', lng);\n      try {\n        const res = await fetch(\'/api/process-civic-report\', {\n          method: \'POST\',\n          body: formData,\n        });\n        const data = await res.json();\n        console.log(\'Engine Response Parsed:\', data);\n        setSuccess(true);\n      } catch (err) {\n        console.error(\'Network execution failure:\', err);\n      } finally {\n        setUploading(false);\n      }\n    };\n\n    if (navigator.geolocation) {\n      navigator.geolocation.getCurrentPosition(\n        (pos) => sendData(pos.coords.latitude.toString(), pos.coords.longitude.toString()),\n        (err) => {\n          console.warn(\'Geolocation failed:\', err);\n          sendData(\'0\', \'0\'); // Fallback coordinates\n        }\n      );\n    } else {\n      sendData(\'0\', \'0\'); // Fallback coordinates\n    }\n  };\n\n  return (\n    <div className=\"p-8 max-w-md mx-auto bg-white text-black rounded-2xl shadow-xl border border-sandalwood-200 flex flex-col items-center relative overflow-hidden\">\n      <div className=\"absolute top-0 right-0 p-4 opacity-10 pointer-events-none\">\n        <Mic size={120} />\n      </div>\n      \n      <div className=\"bg-sandalwood-100 text-sandalwood-800 text-xs font-bold px-3 py-1 rounded-full mb-4 flex items-center gap-1.5 uppercase tracking-wide border border-sandalwood-200\">\n        <Globe size={14} /> {language.toUpperCase()}\n      </div>\n\n      <h3 className=\"text-2xl font-bold mb-3 text-center tracking-tight z-10\">{texts.title}</h3>\n      <p className=\"text-sm text-sandalwood-700 mb-8 text-center leading-relaxed font-medium max-w-[280px] z-10\">\n        {texts.subtitle}\n      </p>\n      \n      <div className=\"flex justify-center items-center mb-6 h-32 z-10\">\n        {!isRecording && !uploading && !success && (\n          <div className=\"flex flex-col items-center gap-3\">\n            <button \n              onClick={startRecording} \n              className=\"h-24 w-24 rounded-full bg-black hover:bg-sandalwood-900 flex items-center justify-center font-semibold transition-all shadow-[0_10px_20px_rgba(0,0,0,0.15)] hover:scale-105 group\"\n              aria-label=\"Start Recording\"\n            >\n              <Mic size={36} className=\"text-white group-hover:scale-110 transition-transform\" />\n            </button>\n            <span className=\"text-xs font-bold tracking-widest text-black uppercase\">{texts.record}</span>\n          </div>\n        )}\n        {isRecording && !uploading && (\n          <div className=\"flex flex-col items-center gap-3\">\n            <button \n              onClick={stopRecording} \n              className=\"h-24 w-24 rounded-full bg-white flex items-center justify-center font-semibold transition-all border-4 border-black hover:scale-105 shadow-[0_0_30px_rgba(0,0,0,0.1)] relative\"\n              aria-label=\"Stop Recording\"\n            >\n              <div className=\"absolute inset-0 rounded-full border-4 border-black an"
      edit_distance: 2
      rel_edit_distance: 2.0671835E-4
      num_matches: 1
      is_non_exact: true
      use_global_match: true
    }
  }
