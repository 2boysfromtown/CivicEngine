  file_change {
    absolute_path_uri: "file:///server.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import express from \'express\';\nimport path from \'path\';\nimport multer from \'multer\';\nimport { GoogleGenAI } from \'@google/genai\';\nimport { createServer as createViteServer } from \'vite\';\n\nconst app = express();\nconst PORT = 3000;\n\n// Setup Multer for memory storage\nconst upload = multer({ storage: multer.memoryStorage() });\n\n// Setup Gemini\nlet ai: GoogleGenAI | null = null;\nfunction getAI() {\n  if (!ai) {\n    if (!process.env.GEMINI_API_KEY) {\n      throw new Error(\'GEMINI_API_KEY environment variable is required\');\n    }\n    ai = new GoogleGenAI({ apiKey: process.env.GEMINI_API_KEY });\n  }\n  return ai;\n}\n\n// In-memory data\nlet issues: any[] = [\n  {\n    issue_id: \"GEOHASH_WARD4_001\",\n    coordinates: { latitude: 12.684, longitude: 78.621 },\n    category: \"WATER_SUPPLY\",\n    status: \"OPEN\",\n    severity_score: 4,\n    priority_score: 8.0,\n    citizen_upvote_count: 42,\n    executive_summary: \"Major fracture in primary underground main water line causing street flooding.\",\n    created_at: new Date(Date.now() - 3600000 * 24 * 2).toISOString(),\n    updated_at: new Date().toISOString(),\n  },\n  {\n    issue_id: \"GEOHASH_WARD2_042\",\n    coordinates: { latitude: 12.690, longitude: 78.610 },\n    category: \"ROADS\",\n    status: \"IN_PROGRESS\",\n    severity_score: 3,\n    priority_score: 5.5,\n    citizen_upvote_count: 15,\n    executive_summary: \"Deep potholes reported near the central school entrance.\",\n    created_at: new Date(Date.now() - 3600000 * 24 * 5).toISOString(),\n    updated_at: new Date().toISOString(),\n  }\n];\nlet projects: any[] = [\n  {\n    project_id: \"PROJ_OVERBRIDGE_W4\",\n    title: \"Ward 4 Overbridge Construction\",\n    department: \"Highways & Infrastructure\",\n    allocated_budget: \"\342\202\2714.2 Crores\",\n    target_completion_date: \"2026-12-15\",\n    sentiment_summary: {\n      positive_votes: 120,\n      negative_criticisms: 412,\n      ai_sentiment_index: -0.45,\n      top_criticism_theme: \"Extended road closures without alternative traffic route coordination.\"\n    }\n  },\n  {\n    project_id: \"PROJ_SOLAR_LIGHTS\",\n    title: \"City-wide Solar Streetlights\",\n    department: \"Energy & Public Safety\",\n    allocated_budget: \"\342\202\2711.5 Crores\",\n    target_completion_date: \"2026-08-30\",\n    sentiment_summary: {\n      positive_votes: 850,\n      negative_criticisms: 120,\n      ai_sentiment_index: 0.78,\n      top_criticism_theme: \"Installation delays in Zone B.\"\n    }\n  }\n];\n\nconst SYSTEM_INSTRUCTION = `\nSYSTEM INSTRUCTION: Senior Civic Data Architect & Real-Time Multimodal Analyst\n\nROLE AND OBJECTIVE:\nYou are an advanced, hyper-objective civic intelligence agent deployed to sit between local citizens and municipal authorities. Your primary task is to process citizen communications (live audio feeds, uploaded audio recordings, images, and geolocation strings) to verify legitimacy, extract structural context, resolve regional accents/languages, and output flawless, machine-readable JSON data. You must filter out emotional fluff, exaggerations, or irrelevant spam, converting raw input into structural facts.\n\nFUNCTIONAL CAPABILITIES:\n1. Dynamic Audio Processing & Translation: Transcribe speech from any Indian regional language or dialect (including Tamil, Hindi, Kannada, Telugu, etc.) and code-switched English (Hinglish/Tanglish). Natively translate the core meaning to precise English.\n2. Multimodal Visual Verification: Analyze uploaded images to verify if a legitimate municipal or civic problem is present (e.g., potholes, garbage heaps, broken streetlights, water stagnation, damaged public property). Flag the image as spam if it contains selfies, internet memes, unrelated graphics, or shows no actual infrastructure failure.\n3. Structural Severity Grading: Based entirely on the visual evidence and descriptive audio gravity, assign an objective Severity Rating from 1 (minor cosmetic issue) to 5 (critical safety hazard or total systemic failure).\n\nCONVERSATIONAL PROTOCOL (FOR LIVE INTERACTIVE VOICE SESSIONS):\n- If vital parameters are missing from the citizen\'s report (such as specific landmarks, approximate scale of the problem, or clear impacts on safety), ask a short, polite, conversational follow-up question in the speaker\'s language.\n- Do not speak like an AI assistant. Speak like an efficient, empathetic local emergency operator. Keep responses under 20 words.\n\nOUTPUT SCHEMA SPECIFICATION:\nWhen the conversation concludes, or when a static multi-modal payload is evaluated, you must emit a single JSON object. Do not include markdown code block formatting (e.g., do not wrap in \\`\\`\\`json). \n\nStrictly adhere to the following schema structure:\n{\n  \"is_legitimate_civic_issue\": boolean,\n  \"spam_reason\": \"string or null if pass\",\n  \"extracted_parameters\": {\n    \"category\": \"ROADS\" | \"WATER_SUPPLY\" | \"SANITATION\" | \"ELECTRICITY\" | \"PUBLIC_SAFETY\" | \"OTHER\",\n    \"raw_transcription_native\": \"string\",\n    \"translated_summary_english\": \"string\",\n    \"visual_evidence_analysis\": \"string detailing what is seen in the image\",\n    \"landmark_or_location_clues\": \"string describing any mentioned local landmarks\"\n  },\n  \"metrics\": {\n    \"severity_rating\": integer (1-5),\n    \"safety_hazard_present\": boolean,\n    \"estimated_affected_population_density\": \"LOW\" | \"MEDIUM\" | \"HIGH\"\n  },\n  \"project_criticism\": {\n    \"is_criticism_of_existing_work\": boolean,\n    \"associated_project_name_if_mentioned\": \"string or null\",\n    \"sentiment_score\": float (-1.0 to 1.0)\n  },\n  \"requires_live_followup\": boolean\n}\n\nCRITICAL CONSTRAINTS:\n- Never assume coordinates or details not present in the input or explicitly stated by the user.\n- If \"is_legitimate_civic_issue\" is evaluated as false, immediately nullify the remaining telemetry metrics and state the exact spam reason.\n- Output absolute JSON. No conversational intro or outro text.\n`;\n\napp.use(express.json());\n\napp.post(\'/api/process-civic-report\', upload.single(\'audio\'), async (req, res) => {\n  try {\n    const lat = req.body.lat;\n    const lng = req.body.lng;\n    const audioFile = req.file;\n    \n    if (!audioFile) {\n       return res.status(400).json({ error: \'Audio file is required\' });\n    }\n\n    const filePart = {\n      inlineData: {\n        data: audioFile.buffer.toString(\'base64\'),\n        mimeType: audioFile.mimetype,\n      },\n    };\n\n    const aiClient = getAI();\n    const response = await aiClient.models.generateContent({\n      model: \'gemini-1.5-pro\',\n      contents: [\n        {\n          role: \'user\',\n          parts: [\n            filePart,\n            { text: \\`Analyze this civic report. Coordinates: lat \\${lat}, lng \\${lng}\\` }\n          ]\n        }\n      ],\n      config: {\n        systemInstruction: SYSTEM_INSTRUCTION,\n        responseMimeType: \'application/json\',\n      }\n    });\n\n    let rawOutput = response.text() || \'{}\';\n    // Remove markdown code blocks if present\n    if (rawOutput.startsWith(\'\\`\\`\\`json\')) {\n       rawOutput = rawOutput.replace(/\\`\\`\\`json/g, \'\').replace(/\\`\\`\\`/g, \'\').trim();\n    } else if (rawOutput.startsWith(\'\\`\\`\\`\')) {\n       rawOutput = rawOutput.replace(/\\`\\`\\`/g, \'\').trim();\n    }\n    \n    const parsed = JSON.parse(rawOutput);\n\n    // If it\'s a legitimate issue, add it to our in-memory store\n    if (parsed.is_legitimate_civic_issue) {\n       const Sg = parsed.metrics?.severity_rating || 1;\n       const Vc = 0; // new report\n       const deltaT = 0;\n       \n       const Ws = 2.0;\n       const Wv = 1.5;\n       const Wt = 1.0;\n       \n       const priorityScore = (Ws * Sg) + (Wv * Math.log(Vc + 1)) + (Wt * (deltaT / 24));\n       \n       const newIssue = {\n         issue_id: \\`REP_\\${Math.floor(Math.random() * 100000)}\\`,\n         coordinates: { latitude: parseFloat(lat || \'0\'), longitude: parseFloat(lng || \'0\') },\n         category: parsed.extracted_parameters?.category || \'OTHER\',\n         status: \'OPEN\',\n         severity_score: Sg,\n         priority_score: priorityScore,\n         citizen_upvote_count: Vc,\n         executive_summary: parsed.extracted_parameters?.translated_summary_english || \'No summary\',\n         created_at: new Date().toISOString(),\n         updated_at: new Date().toISOString(),\n       };\n       issues.push(newIssue);\n    }\n\n    res.json({ success: true, ai_response: parsed });\n  } catch (error: any) {\n    console.error(\'Error processing report:\', error);\n    res.status(500).json({ error: error.message || \'Failed to process report\' });\n  }\n});\n\napp.get(\'/api/issues\', (req, res) => {\n  res.json(issues);\n});\n\napp.get(\'/api/projects\', (req, res) => {\n  res.json(projects);\n});\n\n// Vite middleware for development\nasync function startServer() {\n  if (process.env.NODE_ENV !== \"production\") {\n    const vite = await createViteServer({\n      server: { middlewareMode: true },\n      appType: \"spa\",\n    });\n    app.use(vite.middlewares);\n  } else {\n    const distPath = path.join(process.cwd(), \'dist\');\n    app.use(express.static(distPath));\n    app.get(\'*\', (req, res) => {\n      res.sendFile(path.join(distPath, \'index.html\'));\n    });\n  }\n\n  app.listen(PORT, \"0.0.0.0\", () => {\n    console.log(\\`Server running on http://localhost:\\${PORT}\\`);\n  });\n}\n\nstartServer();\n"
    }
