w-xl border border-sandalwood-200\">          <div className=\"flex justify-center mb-8\">            <div className=\"w-12 h-12 rounded-xl bg-black text-white flex items-center justify-center\">              <Shield size={24} />            </div>          </div>                    <h1 className=\"text-2xl font-bold text-center text-black tracking-tight mb-2\">            CivicEngine          </h1>          <p className=\"text-center text-sandalwood-600 mb-8 font-medium\">            {authView === \'login\' ? \'Sign in to continue\' : \'Create your account\'}          </p>          <form onSubmit={authView === \'login\' ? handleLogin : handleSignup} className=\"space-y-5\">            {authView === \'signup\' && (              <>                <div>                  <label className=\"block text-sm font-semibold text-black mb-1\">Name</label>                  <input                     type=\"text\"                     required                     value={name}                    onChange={e => setName(e.target.value)}                    className=\"w-full px-4 py-2 bg-sandalwood-50 border border-sandalwood-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-black focus:border-transparent text-black\"                    placeholder=\"Your full name\"                  />                </div>                                <div>                  <label className=\"block text-sm font-semibold text-black mb-1 flex items-center gap-2\">                    <Globe size={16} /> Preferred Language                  </label>                  <select                     value={language}                    onChange={e => setLanguage(e.target.value)}                    className=\"w-full px-4 py-2 bg-sandalwood-50 border border-sandalwood-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-black text-black\"                  >                    {LANGUAGES.map(lang => (                      <option key={lang.code} value={lang.code}>{lang.name}</option>               