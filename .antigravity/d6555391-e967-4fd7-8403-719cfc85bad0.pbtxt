      replacement_content: "import React, { useState, useRef } from \'react\';\nimport { Mic, Square, Loader2, CheckCircle2, Globe, Camera, ArrowRight, Send, MessageSquare, PhoneCall } from \'lucide-react\';\nimport { clsx, type ClassValue } from \'clsx\';\nimport { twMerge } from \'tailwind-merge\';\nimport LiveOperator from \'./LiveOperator\';\n\nfunction cn(...inputs: ClassValue[]) {\n  return twMerge(clsx(inputs));\n}\n\nconst LANG_MESSAGES: Record<string, any> = {\n  en: { \n    title: \"Report an Issue\", \n    subtitle: \"Help us improve the community.\",\n    step1: \"What is the issue?\",\n    step1Desc: \"Describe the problem or tap the mic to speak.\",\n    step2: \"Add a Photo\",\n    step2Desc: \"Upload or capture a photo to help us verify.\",\n    record: \"RECORD\", \n    stop: \"STOP\", \n    analyzing: \"Analyzing Multimodal Input...\", \n    success: \"Report logged securely.\", \n    again: \"Report another issue\",\n    next: \"Next Step\",\n    submit: \"Submit Report\",\n    placeholder: \"E.g. There is a deep pothole on Main St...\"\n  },\n  hi: { \n    title: \"\340\244\270\340\244\256\340\244\270\340\245\215\340\244\257\340\244\276 \340\244\246\340\244\260\340\245\215\340\244\234 \340\244\225\340\244\260\340\245\207\340\244\202\", \n    subtitle: \"\340\244\270\340\244\256\340\245\201\340\244\246\340\244\276\340\244\257 \340\244\225\340\245\213 \340\244\254\340\245\207\340\244\271\340\244\244\340\244\260 \340\244\254\340\244\250\340\244\276\340\244\250\340\245\207 \340\244\256\340\245\207\340\244\202 \340\244\271\340\244\256\340\244\276\340\244\260\340\245\200 \340\244\256\340\244\246\340\244\246 \340\244\225\340\244\260\340\245\207\340\244\202\340\245\244\",\n    step1: \"\340\244\270\340\244\256\340\244\270\340\245\215\340\244\257\340\244\276 \340\244\225\340\245\215\340\244\257\340\244\276 \340\244\271\340\245\210?\",\n    step1Desc: \"\340\244\270\340\244\256\340\244\270\340\245\215\340\244\257\340\244\276 \340\244\225\340\244\276 \340\2