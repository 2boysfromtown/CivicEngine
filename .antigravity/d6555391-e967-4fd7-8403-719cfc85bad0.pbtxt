    instruction: "Implement step-by-step civic report intake interface."
    replacement_infos {
      original_chunk {
        target_content: "import { useState, useRef } from \'react\';\nimport { Mic, Square, Loader2, CheckCircle2, Globe } from \'lucide-react\';\nimport { clsx, type ClassValue } from \'clsx\';\nimport { twMerge } from \'tailwind-merge\';\n\nfunction cn(...inputs: ClassValue[]) {\n  return twMerge(clsx(inputs));\n}\n\nconst LANG_MESSAGES: Record<string, { title: string, subtitle: string, record: string, stop: string, analyzing: string, success: string, again: string }> = {\n  en: { title: \"Civic Voice Agent\", subtitle: \"Hold record to state an issue or criticize an ongoing municipal project. Audio is auto-translated and verified.\", record: \"RECORD\", stop: \"STOP\", analyzing: \"Analyzing Multimodal Input...\", success: \"Report logged securely.\", again: \"Report another issue\" },\n  hi: { title: \"\340\244\250\340\244\276\340\244\227\340\244\260\340\244\277\340\244\225 \340\244\265\340\245\211\340\244\257\340\244\270 \340\244\217\340\244\234\340\245\207\340\244\202\340\244\237\", subtitle: \"\340\244\225\340\244\277\340\244\270\340\245\200 \340\244\270\340\244\256\340\244\270\340\245\215\340\244\257\340\244\276 \340\244\225\340\245\213 \340\244\254\340\244\244\340\244\276\340\244\250\340\245\207 \340\244\257\340\244\276 \340\244\232\340\244\262 \340\244\260\340\244\271\340\245\200 \340\244\250\340\244\227\340\244\260\340\244\252\340\244\276\340\244\262\340\244\277\340\244\225\340\244\276 \340\244\252\340\244\260\340\244\277\340\244\257\340\245\213\340\244\234\340\244\250\340\244\276 \340\244\225\340\245\200 \340\244\206\340\244\262\340\245\213\340\244\232\340\244\250\340\244\276 \340\244\225\340\244\260\340\244\250\340\245\207 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 \340\244\260\340\244\277\340\244\225\340\245\211\340\244\260\340\245\215\340\244\241 \340\244\246\340\244\254\340\244\276\340\244\217 \340\244\260\340\244\226\340\245\207\340\244\202\340\245\244\", record: \"\340\244\260\340\244\277\340\244\225\340\245\211\340\244\260\340\245\215\340\244\241 \340\244\225\340\244\260\340\245\207\340\244\202\", stop: \"\340\244\260\340\245\201\340\244\225\340\245\207\340\244\202\", analyzing: \"\340\244\207\340\244\250\340\244\252\340\245\201\340\244\237 \340\244\225\340\244\276 \340\244\265\340\244\277\340\244\266\340\245\215\340\244\262\340\245\207\340\244\267\340\244\243 \340\244\225\340\244\260 \340\244\260\340\244\271\340\244\276 \340\244\271\340\245\210...\", success: \"\340\244\260\340\244\277\340\244\252\340\245\213\340\244\260\340\245\215\340\244\237 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244 \340\244\260\340\245\202\340\244\252 \340\244\270\340\245\207 \340\244\246\340\244\260\340\245\215\340\244\234 \340\244\225\340\245\200 \340\244\227\340\244\210\340\245\244\", again: \"\340\244\246\340\245\202\340\244\270\340\244\260\340\245\200 \340\244\270\340\244\256\340\244\270\340\245\215\340\244\257\340\244\276 \340\244\246\340\244\260\340\245\215\340\244\234 \340\244\225\340\244\260\340\245\207\340\244\202\" },\n  ta: { title: \"\340\256\225\340\257\201\340\256\237\340\256\277\340\256\256\340\256\225\340\257\215\340\256\225\340\256\263\340\257\215 \340\256\225\340\257\201\340\256\260\340\256\262\340\257\215 \340\256\256\340\257\201\340\256\225\340\256\265\340\256\260\340\257\215\", subtitle: \"\340\256\222\340\256\260\340\257\201 \340\256\232\340\256\277\340\256\225\340\257\215\340\256\225\340\256\262\340\257\210\340\256\225\340\257\215 \340\256\225\340\257\202\340\256\261 \340\256\205\340\256\262\340\257\215\340\256\262\340\256\244\340\257\201 \340\256\244\340\256\261\340\257\215\340\256\252\340\257\213\340\256\244\340\257\210\340\256\257 \340\256\244\340\256\277\340\256\237\340\257\215\340\256\237\340\256\244\340\257\215\340\256\244\340\257\210 \340\256\265\340\256\277\340\256\256\340\256\260\340\257\215\340\256\232\340\256\277\340\256\225\340\257\215\340\256\225 \340\256\252\340\256\244\340\256\277\340\256\265\340\257\210 \340\256\205\340\256\264\340\257\201\340\256\244\340\257\215\340\256\244\340\256\277\340\256\252\340\257\215 \340\256\252\340\256\277\340\256\237\340\256\277\340\256\225\340\257\215\340\256\225\340\256\265\340\257\201\340\256\256\340\257\215.\", record: \"\340\256\252\340\256\244\340\256\277\340\256\265\340\257\201\", stop: \"\340\256\250\340\256\277\340\256\261\340\257\201\340\256\244\340\257\215\340\256\244\340\257\201\", analyzing: \"\340\256\252\340\256\225\340\257\201\340\256\252\340\257\215\340\256\252\340\256\276\340\256\257\340\257\215\340\256\265\340\257\201 \340\256\232\340\257\206\340\256\257\340\257\215\340\256\257\340\256\252\340\257\215\340\256\252\340\256\237\340\257\201\340\256\225\340\256\277\340\256\261\340\256\244\340\257\201...\", success: \"\340\256\252\340\257\201\340\256\225\340\256\276\340\256\260\340\257\215 \340\256\252\340\256\276\340\256\244\340\257\201\340\256\225\340\256\276\340\256\252\340\257\215\340\256\252\340\256\276\340\256\225 \340\256\252\340\256\244\340\256\277\340\256\265\340\257\201 \340\256\232\340\257\206\340\256\257\340\257\215\340\256\257\340\256\252\340\257\215\340\256\252\340\256\237\340\257\215\340\256\237\340\256\244\340\257\201.\", again: \"\340\256\256\340\256\261\340\257\215\340\256\261\340\257\212\340\256\260\340\257\201 \340\256\252\340\257\201\340\256\225\340\256\276\340\256\260\340\257\210\340\256\252\340\257\215 \340\256\252\340\256\244\340\256\277\340\256\265\340\257\201\340\256\232\340\257\206\340\256\257\340\257\215\340\256\225\" },\n  kn: { title: \"\340\262\250\340\262\276\340\262\227\340\262\260\340\262\277\340\262\225 \340\262\247\340\263\215\340\262\265\340\262\250\340\262\277 \340\262\217\340\262\234\340\263\206\340\262\202\340\262\237\340\263\215\", subtitle: \"\340\262\270\340\262\256\340\262\270\340\263\215\340\262\257\340\263\206\340\262\257\340\262\250\340\263\215\340\262\250\340\263\201 \340\262\271\340\263\207\340\262\263\340\262\262\340\263\201 \340\262\205\340\262\245\340\262\265\340\262\276 \340\262\250\340\262\241\340\263\206\340\262\257\340\263\201\340\262\244\340\263\215\340\262\244\340\262\277\340\262\260\340\263\201\340\262\265 \340\262\252\340\263\201\340\262\260\340\262\270\340\262\255\340\263\206\340\262\257 \340\262\257\340\263\213\340\262\234\340\262\250\340\263\206\340\262\257\340\262\250\340\263\215\340\262\250\340\263\201 \340\262\237\340\263\200\340\262\225\340\262\277\340\262\270\340\262\262\340\263\201 \340\262\260\340\263\206\340\262\225\340\262\276\340\262\260\340\263\215\340\262\241\340\263\215 \340\262\271\340\262\277\340\262\241\340\262\277\340\262\246\340\263\201\340\262\225\340\263\212\340\262\263\340\263\215\340\262\263\340\262\277.\", record: \"\340\262\260\340\263\206\340\262\225\340\262\276\340\262\260\340\263\215\340\262\241\340\263\215\", stop: \"\340\262\250\340\262\277\340\262\262\340\263\215\340\262\262\340\262\277\340\262\270\340\262\277\", analyzing: \"\340\262\265\340\262\277\340\262\266\340\263\215\340\262\262\340\263\207\340\262\267\340\262\277\340\262\270\340\262\262\340\262\276\340\262\227\340\263\201\340\262\244\340\263\215\340\262\244\340\262\277\340\262\246\340\263\206...\", success: \"\340\262\265\340\262\260\340\262\246\340\262\277\340\262\257\340\262\250\340\263\215\340\262\250\340\263\201 \340\262\270\340\263\201\340\262\260\340\262\225\340\263\215\340\262\267\340\262\277\340\262\244\340\262\265\340\262\276\340\262\227\340\262\277 \340\262\262\340\262\276\340\262\227\340\263\215 \340\262\256\340\262\276\340\262\241\340\262\262\340\262\276\340\262\227\340\262\277\340\262\246\340\263\206.\", again: \"\340\262\256\340\262\244\340\263\215\340\262\244\340\263\212\340\262\202\340\262\246\340\263\201 \340\262\270\340\262\256\340\262\270\340\263\215\340\262\257\340\263\206\340\262\257\340\262\250\340\263\215\340\262\250\340\263\201 \340\262\265\340\262\260\340\262\246\340\262\277 \340\262\256\340\262\276\340\262\241\340\262\277\" },\n  te: { title: \"\340\260\270\340\260\277\340\260\237\340\260\277\340\260\234\340\260\250\340\261\215 \340\260\265\340\260\276\340\260\257\340\260\277\340\260\270\340\261\215 \340\260\217\340\260\234\340\261\206\340\260\202\340\260\237\340\261\215\", subtitle: \"\340\260\270\340\260\256\340\260\270\340\261\215\340\260\257\340\260\250\340\261\201 \340\260\232\340\261\206\340\260\252\340\261\215\340\260\252\340\260\241\340\260\276\340\260\250\340\260\277\340\260\225\340\260\277 \340\260\262\340\261\207\340\260\246\340\260\276 \340\260\225\340\261\212\340\260\250\340\260\270\340\260\276\340\260\227\340\261\201\340\260\244\340\261\201\340\260\250\340\261\215\340\260\250 \340\260\256\340\261\201\340\260\250\340\260\277\340\260\270\340\260\277\340\260\252\340\260\262\340\261\215 \340\260\252\340\261\215\340\260\260\340\260\276\340\260\234\340\261\206\340\260\225\340\261\215\340\260\237\340\261\215\342\200\214\340\260\250\340\261\201 \340\260\265\340\260\277\340\260\256\340\260\260\340\261\215\340\260\266\340\260\277\340\260\202\340\260\232\340\260\241\340\260\276\340\260\250\340\260\277\340\260\225\340\260\277 \340\260\260\340\260\277\340\260\225\340\260\276\340\260\260\340\261\215\340\260\241\340\261\215 \340\260\252\340\260\237\340\261\215\340\260\237\340\261\201\340\260\225\340\261\213\340\260\202\340\260\241\340\260\277.\", record: \"\340\260\260\340\260\277\340\260\225\340\260\276\340\260\260\340\261\215\340\262\241\340\263\215\", stop: \"\340\260\206\340\260\252\340\261\201\", analyzing: \"\340\260\265\340\260\277\340\260\266\340\261\215\340\260\262\340\261\207\340\260\267\340\260\277\340\260\270\340\261\215\340\260\244\340\261\213\340\260\202\340\260\246\340\260\277...\", success: \"\340\260\250\340\260\277\340\260\265\340\261\207\340\260\246\340\260\277\340\260\225 \340\260\270\340\261\201\340\260\260\340\260\225\340\261\215\340\260\267\340\260\277\340\260\244\340\260\202\340\260\227\340\260\276 \340\260\262\340\260\276\340\260\227\340\261\215 \340\260\232\340\261\207\340\260\257\340\260\254\340\260\241\340\260\277\340\260\202\340\260\246\340\260\277.\", again: \"\340\260\256\340\260\260\340\261\212\340\260\225 \340\260\270\340\260\256\340\260\270\340\261\215\340\260\257\340\260\250\340\261\201 \340\260\250\340\260\277\340\260\265\340\261\207\340\260\246\340\260\277\340\260\202\340\260\232\340\260\202\340\260\241\340\260\277\" }\n};\n\nexport default function VoiceReporter({ language = \'en\' }: { language?: string }) {\n  const [isRecording, setIsRecording] = useState(false);\n  const [uploading, setUploading] = useState(false);\n  const [success, setSuccess] = useState(false);\n  const mediaRecorderRef = useRef<MediaRecorder | null>(null);\n  const audioChunksRef = useRef<Blob[]>([]);\n  \n  const texts = LANG_MESSAGES[language] || LANG_MESSAGES.en;\n\n  const startRecording = async () => {\n    try {\n      setSuccess(false);\n      audioChunksRef.current = [];\n      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });\n      const mediaRecorder = new MediaRecorder(stream, { mimeType: \'audio/webm\' });\n      \n      mediaRecorder.ondataavailable = (event) => {\n        if (event.data.size > 0) audioChunksRef.current.push(event.data);\n      };\n\n      mediaRecorder.onstop = async () => {\n        const audioBlob = new Blob(audioChunksRef.current, { type: \'audio/webm\' });\n        await sendToCivicEngine(audioBlob);\n      };\n\n      mediaRecorderRef.current = mediaRecorder;\n      mediaRecorder.start();\n      setIsRecording(true);\n    } catch (err) {\n      console.error(\'Microphone access denied or error:\', err);\n      alert(\'Could not access microphone.\');\n    }\n  };\n\n  const stopRecording = () => {\n    if (mediaRecorderRef.current && isRecording) {\n      mediaRecorderRef.current.stop();\n      mediaRecorderRef.current.stream.getTracks().forEach(track => track.stop());\n      setIsRecording(false);\n    }\n  };\n\n  const sendToCivicEngine = async (audioBlob: Blob) => {\n    setUploading(true);\n    const formData = new FormData();\n    formData.append(\'audio\', audioBlob, \'report.webm\');\n    formData.append(\'language\', language);\n    \n    const sendData = async (lat: string, lng: string) => {\n      formData.append(\'lat\', lat);\n      formData.append(\'lng\', lng);\n      try {\n        const res = await fetch(\'/api/process-civic-report\', {\n          method: \'POST\',\n          body: formData,\n        });\n        const data = await res.json();\n        console.log(\'Engine Response Parsed:\', data);\n        setSuccess(true);\n      } catch (err) {\n        console.error(\'Network execution failure:\', err);\n      } finally {\n        setUploading(false);\n      }\n    };\n\n    if (navigator.geolocation) {\n      navigator.geolocation.getCurrentPosition(\n        (pos) => sendData(pos.coords.latitude.toString(), pos.coords.longitude.toString()),\n        (err) => {\n          console.warn(\'Geolocation failed:\', err);\n          sendData(\'0\', \'0\'); // Fallback coordinates\n        }\n      );\n    } else {\n      sendData(\'0\', \'0\'); // Fallback coordinates\n    }\n  };\n\n  return (\n    <div className=\"p-8 max-w-md mx-auto bg-white text-black rounded-2xl shadow-xl border border-sandalwood-200 flex flex-col items-center relative overflow-hidden\">\n      <div className=\"absolute top-0 right-0 p-4 opacity-10 pointer-events-none\">\n        <Mic size={120} />\n      </div>\n      \n      <div className=\"bg-sandalwood-100 text-sandalwood-800 text-xs font-bold px-3 py-1 rounded-full mb-4 flex items-center gap-1.5 uppercase tracking-wide border border-sandalwood-200\">\n        <Globe size={14} /> {language.toUpperCase()}\n      </div>\n\n      <h3 className=\"text-2xl font-bold mb-3 text-center tracking-tight z-10\">{texts.title}</h3>\n      <p className=\"text-sm text-sandalwood-700 mb-8 text-center leading-relaxed font-medium max-w-[280px] z-10\">\n        {texts.subtitle}\n      </p>\n      \n      <div className=\"flex justify-center items-center mb-6 h-32 z-10\">\n        {!isRecording && !uploading && !success && (\n          <div className=\"flex flex-col items-center gap-3\">\n            <button \n              onClick={startRecording} \n              className=\"h-24 w-24 rounded-full bg-black hover:bg-sandalwood-900 flex items-center justify-center font-semibold transition-all shadow-[0_10px_20px_rgba(0,0,0,0.15)] hover:scale-105 group\"\n              aria-label=\"Start Recording\"\n            >\n              <Mic size={36} className=\"text-white group-hover:scale-110 transition-transform\" />\n            </button>\n            <span className=\"text-xs font-bold tracking-widest text-black uppercase\">{texts.record}</span>\n          </div>\n        )}\n        {isRecording && !uploading && (\n          <div className=\"flex flex-col items-center gap-3\">\n            <button \n              onClick={stopRecording} \n              className=\"h-24 w-24 rounded-full bg-white flex items-center justify-center font-semibold transition-all border-4 border-black hover:scale-105 shadow-[0_0_30px_rgba(0,0,0,0.1)] relative\"\n              aria-label=\"Stop Recording\"\n            >\n              <div className=\"absolute inset-0 rounded-full border-4 border-black animate-ping opacity-20\" />\n              <Square size={28} className=\"text-black\" fill=\"currentColor\" />\n            </button>\n            <span className=\"text-xs font-bold tracking-widest text-black uppercase animate-pulse\">{texts.stop}</span>\n          </div>\n        )}\n        {uploading && (\n          <div className=\"flex flex-col items-center space-y-4 text-black\">\n            <Loader2 size={40} className=\"animate-spin text-sandalwood-600\" />\n            <span className=\"text-sm font-bold tracking-wide\">{texts.analyzing}</span>\n          </div>\n        )}\n        {success && (\n          <div className=\"flex flex-col items-center space-y-4 text-black\">\n            <CheckCircle2 size={48} className=\"text-sandalwood-600\" />\n            <span className=\"text-sm font-bold tracking-wide\">{texts.success}</span>\n            <button \n              onClick={() => setSuccess(false)}\n              className=\"mt-4 px-5 py-2.5 bg-black text-white text-sm font-semibold rounded-lg hover:bg-sandalwood-900 transition-colors shadow-md\"\n            >\n              {texts.again}\n            </button>\n          </div>\n        )}\n      </div>\n      \n      {isRecording && (\n        <div className=\"flex items-center space-x-2 text-black text-sm font-bold animate-pulse mt-4 bg-sandalwood-100 px-3 py-1 rounded-full border border-sandalwood-200\">\n          <div className=\"h-2 w-2 bg-black rounded-full\" />\n          <span>Recording live...</span>\n        </div>\n      )}\n    </div>\n  );\n}"
        replacement_content: "import { useState, useRef } from \'react\';\nimport { Mic, Square, Loader2, CheckCircle2, Globe, Camera, Image as ImageIcon, Send, ArrowRight, Upload } from \'lucide-react\';\nimport { clsx, type ClassValue } from \'clsx\';\nimport { twMerge } from \'tailwind-merge\';\n\nfunction cn(...inputs: ClassValue[]) {\n  return twMerge(clsx(inputs));\n}\n\nconst LANG_MESSAGES: Record<string, any> = {\n  en: { \n    title: \"Report an Issue\", \n    subtitle: \"Help us improve the community.\",\n    step1: \"What is the issue?\",\n    step1Desc: \"Describe the problem or tap the mic to speak.\",\n    step2: \"Add a Photo\",\n    step2Desc: \"Upload or capture a photo to help us verify.\",\n    record: \"RECORD\", \n    stop: \"STOP\", \n    analyzing: \"Analyzing Multimodal Input...\", \n    success: \"Report logged securely.\", \n    again: \"Report another issue\",\n    next: \"Next Step\",\n    submit: \"Submit Report\",\n    placeholder: \"E.g. There is a deep pothole on Main St...\"\n  },\n  hi: { \n    title: \"\340\244\270\340\244\256\340\244\270\340\245\215\340\244\257\340\244\276 \340\244\246\340\244\260\340\245\215\340\244\234 \340\244\225\340\244\260\340\245\207\340\244\202\", \n    subtitle: \"\340\244\270\340\244\256\340\245\201\340\244\246\340\244\276\340\244\257 \340\244\225\340\245\213 \340\244\254\340\245\207\340\244\271\340\244\244\340\244\260 \340\244\254\340\244\250\340\244\276\340\244\250\340\245\207 \340\244\256\340\245\207\340\244\202 \340\244\271\340\244\256\340\244\276\340\244\260\340\245\200 \340\244\256\340\244\246\340\244\246 \340\244\225\340\244\260\340\245\207\340\244\202\340\245\244\",\n    step1: \"\340\244\270\340\244\256\340\244\270\340\245\215\340\244\257\340\244\276 \340\244\225\340\245\215\340\244\257\340\244\276 \340\244\271\340\245\210?\",\n    step1Desc: \"\340\244\270\340\244\256\340\244\270\340\245\215\340\244\257\340\244\276 \340\244\225\340\244\276 \340\244\265\340\244\260\340\245\215\340\244\243\340\244\250 \340\244\225\340\244\260\340\245\207\340\244\202 \340\244\257\340\244\276 \340\244\254\340\245\213\340\244\262\340\244\250\340\245\207 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 \340\244\256\340\244\276\340\244\207\340\244\225 \340\244\237\340\245\210\340\244\252 \340\244\225\340\244\260\340\245\207\340\244\202\340\245\244\",\n    step2: \"\340\244\217\340\244\225 \340\244\253\340\245\213\340\244\237\340\245\213 \340\244\234\340\245\213\340\244\241\340\244\274\340\245\207\340\244\202\",\n    step2Desc: \"\340\244\270\340\244\244\340\245\215\340\244\257\340\244\276\340\244\252\340\244\277\340\244\244 \340\244\225\340\244\260\340\244\250\340\245\207 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 \340\244\253\340\245\213\340\244\237\340\245\213 \340\244\205\340\244\252\340\244\262\340\245\213\340\244\241 \340\244\225\340\244\260\340\245\207\340\244\202\340\245\244\",\n    record: \"\340\244\260\340\244\277\340\244\225\340\245\211\340\244\260\340\245\215\340\244\241 \340\244\225\340\244\260\340\245\207\340\244\202\", \n    stop: \"\340\244\260\340\245\201\340\244\225\340\245\207\340\244\202\", \n    analyzing: \"\340\244\207\340\244\250\340\244\252\340\245\201\340\244\237 \340\244\225\340\244\276 \340\244\265\340\244\277\340\244\266\340\245\215\340\244\262\340\245\207\340\244\267\340\244\243 \340\244\225\340\244\260 \340\244\260\340\244\271\340\244\276 \340\244\271\340\245\210...\", \n    success: \"\340\244\260\340\244\277\340\244\252\340\245\213\340\244\260\340\245\215\340\244\237 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244 \340\244\260\340\245\202\340\244\252 \340\244\270\340\245\207 \340\244\246\340\244\260\340\245\215\340\244\234 \340\244\225\340\245\200 \340\244\227\340\244\210\340\245\244\", \n    again: \"\340\244\246\340\245\202\340\244\270\340\244\260\340\245\200 \340\244\270\340\244\256\340\244\270\340\245\215\340\244\257\340\244\276 \340\244\246\340\244\260\340\245\215\340\244\234 \340\244\225\340\244\260\340\245\207\340\244\202\",\n    next: \"\340\244\205\340\244\227\340\244\262\340\244\276 \340\244\225\340\244\246\340\244\256\",\n    submit: \"\340\244\260\340\244\277\340\244\252\340\245\213\340\244\260\340\245\215\340\244\237 \340\244\234\340\244\256\340\244\276 \340\244\225\340\244\260\340\245\207\340\244\202\",\n    placeholder: \"\340\244\211\340\244\246\340\244\276\340\244\271\340\244\260\340\244\243: \340\244\256\340\245\201\340\244\226\340\245\215\340\244\257 \340\244\270\340\244\241\340\244\274\340\244\225 \340\244\252\340\244\260 \340\244\217\340\244\225 \340\244\227\340\244\271\340\244\260\340\244\276 \340\244\227\340\244\241\340\245\215\340\244\242\340\244\276 \340\244\271\340\245\210...\"\n  }\n};\n\nexport default function VoiceReporter({ language = \'en\' }: { language?: string }) {\n  const [step, setStep] = useState<1 | 2 | 3 | 4>(1); // 1: Issue, 2: Photo, 3: Uploading, 4: Success\n  const [textDesc, setTextDesc] = useState(\'\');\n  const [audioBlob, setAudioBlob] = useState<Blob | null>(null);\n  const [imageFile, setImageFile] = useState<File | null>(null);\n  \n  const [isRecording, setIsRecording] = useState(false);\n  const mediaRecorderRef = useRef<MediaRecorder | null>(null);\n  const audioChunksRef = useRef<Blob[]>([]);\n  \n  const fileInputRef = useRef<HTMLInputElement>(null);\n  \n  const texts = LANG_MESSAGES[language] || LANG_MESSAGES.en;\n\n  const startRecording = async () => {\n    try {\n      setAudioBlob(null);\n      audioChunksRef.current = [];\n      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });\n      const mediaRecorder = new MediaRecorder(stream, { mimeType: \'audio/webm\' });\n      \n      mediaRecorder.ondataavailable = (event) => {\n        if (event.data.size > 0) audioChunksRef.current.push(event.data);\n      };\n\n      mediaRecorder.onstop = () => {\n        const blob = new Blob(audioChunksRef.current, { type: \'audio/webm\' });\n        setAudioBlob(blob);\n      };\n\n      mediaRecorderRef.current = mediaRecorder;\n      mediaRecorder.start();\n      setIsRecording(true);\n    } catch (err) {\n      console.error(\'Microphone access denied or error:\', err);\n      alert(\'Could not access microphone.\');\n    }\n  };\n\n  const stopRecording = () => {\n    if (mediaRecorderRef.current && isRecording) {\n      mediaRecorderRef.current.stop();\n      mediaRecorderRef.current.stream.getTracks().forEach(track => track.stop());\n      setIsRecording(false);\n    }\n  };\n\n  const handleImageUpload = (e: React.ChangeEvent<HTMLInputElement>) => {\n    if (e.target.files && e.target.files[0]) {\n      setImageFile(e.target.files[0]);\n    }\n  };\n\n  const submitReport = async () => {\n    setStep(3);\n    const formData = new FormData();\n    if (audioBlob) formData.append(\'audio\', audioBlob, \'report.webm\');\n    if (imageFile) formData.append(\'image\', imageFile);\n    if (textDesc) formData.append(\'text\', textDesc);\n    formData.append(\'language\', language);\n    \n    const sendData = async (lat: string, lng: string) => {\n      formData.append(\'lat\', lat);\n      formData.append(\'lng\', lng);\n      try {\n        const res = await fetch(\'/api/process-civic-report\', {\n          method: \'POST\',\n          body: formData,\n        });\n        const data = await res.json();\n        console.log(\'Engine Response Parsed:\', data);\n        setStep(4);\n      } catch (err) {\n        console.error(\'Network execution failure:\', err);\n        alert(\'Failed to submit report. Please try again.\');\n        setStep(2);\n      }\n    };\n\n    if (navigator.geolocation) {\n      navigator.geolocation.getCurrentPosition(\n        (pos) => sendData(pos.coords.latitude.toString(), pos.coords.longitude.toString()),\n        (err) => {\n          console.warn(\'Geolocation failed:\', err);\n          sendData(\'0\', \'0\'); // Fallback\n        }\n      );\n    } else {\n      sendData(\'0\', \'0\'); // Fallback\n    }\n  };\n\n  const resetForm = () => {\n    setStep(1);\n    setTextDesc(\'\');\n    setAudioBlob(null);\n    setImageFile(null);\n  };\n\n  return (\n    <div className=\"p-8 max-w-md mx-auto bg-white text-black rounded-2xl shadow-xl border border-sandalwood-200 flex flex-col relative overflow-hidden\">\n      <div className=\"absolute top-0 right-0 p-4 opacity-5 pointer-events-none\">\n        <Mic size={120} />\n      </div>\n      \n      <div className=\"bg-sandalwood-100 text-sandalwood-800 text-xs font-bold px-3 py-1 rounded-full mb-6 flex items-center self-start gap-1.5 uppercase tracking-wide border border-sandalwood-200\">\n        <Globe size={14} /> {language.toUpperCase()}\n      </div>\n\n      {step === 1 && (\n        <div className=\"z-10 animate-in fade-in slide-in-from-right-4 duration-300\">\n          <h3 className=\"text-2xl font-bold mb-2 tracking-tight\">{texts.step1}</h3>\n          <p className=\"text-sm text-sandalwood-700 mb-6 font-medium\">{texts.step1Desc}</p>\n          \n          <textarea\n            value={textDesc}\n            onChange={(e) => setTextDesc(e.target.value)}\n            placeholder={texts.placeholder}\n            className=\"w-full h-32 p-4 bg-sandalwood-50 border border-sandalwood-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-black resize-none text-black mb-4\"\n          />\n\n          <div className=\"flex items-center justify-between mb-6\">\n            <div className=\"flex items-center gap-3\">\n              {!isRecording ? (\n                <button \n                  onClick={startRecording} \n                  className={cn(\"h-12 w-12 rounded-full flex items-center justify-center font-semibold transition-all shadow-md hover:scale-105\", audioBlob ? \"bg-sandalwood-200 text-black\" : \"bg-black text-white\")}\n                >\n                  <Mic size={20} />\n                </button>\n              ) : (\n                <button \n                  onClick={stopRecording} \n                  className=\"h-12 w-12 rounded-full bg-white flex items-center justify-center font-semibold transition-all border-2 border-black hover:scale-105 relative\"\n                >\n                  <div className=\"absolute inset-0 rounded-full border-2 border-black animate-ping opacity-20\" />\n                  <Square size={16} className=\"text-black\" fill=\"currentColor\" />\n                </button>\n              )}\n              {isRecording && <span className=\"text-xs font-bold text-red-600 animate-pulse\">Recording...</span>}\n              {!isRecording && audioBlob && <span className=\"text-xs font-bold text-sandalwood-600\">Audio recorded</span>}\n            </div>\n          </div>\n\n          <button \n            onClick={() => setStep(2)}\n            disabled={!textDesc && !audioBlob}\n            className=\"w-full py-3 bg-black text-white font-bold rounded-xl hover:bg-sandalwood-900 transition-colors shadow-md flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed\"\n          >\n            {texts.next} <ArrowRight size={18} />\n          </button>\n        </div>\n      )}\n\n      {step === 2 && (\n        <div className=\"z-10 animate-in fade-in slide-in-from-right-4 duration-300\">\n          <h3 className=\"text-2xl font-bold mb-2 tracking-tight\">{texts.step2}</h3>\n          <p className=\"text-sm text-sandalwood-700 mb-6 font-medium\">{texts.step2Desc}</p>\n          \n          <div \n            onClick={() => fileInputRef.current?.click()}\n            className={cn(\n              \"w-full h-40 border-2 border-dashed rounded-xl flex flex-col items-center justify-center cursor-pointer transition-colors mb-6\",\n              imageFile ? \"border-black bg-sandalwood-100\" : \"border-sandalwood-300 bg-sandalwood-50 hover:bg-sandalwood-100 hover:border-sandalwood-400\"\n            )}\n          >\n            {imageFile ? (\n              <>\n                <CheckCircle2 size={32} className=\"text-black mb-2\" />\n                <span className=\"text-sm font-bold text-black\">{imageFile.name}</span>\n              </>\n            ) : (\n              <>\n                <Camera size={32} className=\"text-sandalwood-600 mb-2\" />\n                <span className=\"text-sm font-bold text-sandalwood-800\">Tap to browse or capture</span>\n              </>\n            )}\n            <input \n              type=\"file\" \n              accept=\"image/*\" \n              capture=\"environment\"\n              className=\"hidden\" \n              ref={fileInputRef}\n              onChange={handleImageUpload}\n            />\n          </div>\n\n          <div className=\"flex gap-3\">\n            <button \n              onClick={() => setStep(1)}\n              className=\"px-4 py-3 bg-white border border-sandalwood-300 text-black font-bold rounded-xl hover:bg-sandalwood-50 transition-colors\"\n            >\n              Back\n            </button>\n            <button \n              onClick={submitReport}\n              className=\"flex-1 py-3 bg-black text-white font-bold rounded-xl hover:bg-sandalwood-900 transition-colors shadow-md flex items-center justify-center gap-2\"\n            >\n              {texts.submit} <Send size={18} />\n            </button>\n          </div>\n        </div>\n      )}\n\n      {step === 3 && (\n        <div className=\"z-10 flex flex-col items-center justify-center py-12 animate-in fade-in duration-300\">\n          <Loader2 size={48} className=\"animate-spin text-black mb-4\" />\n          <h3 className=\"text-xl font-bold text-black mb-2 text-center\">{texts.analyzing}</h3>\n          <p className=\"text-sm text-sandalwood-600 text-center font-medium\">Please wait while our agent reviews your report.</p>\n        </div>\n      )}\n\n      {step === 4 && (\n        <div className=\"z-10 flex flex-col items-center justify-center py-10 animate-in fade-in scale-in-95 duration-500\">\n          <CheckCircle2 size={64} className=\"text-black mb-4\" />\n          <h3 className=\"text-2xl font-bold text-black mb-2 tracking-tight text-center\">{texts.success}</h3>\n          <p className=\"text-sm text-sandalwood-700 mb-8 text-center font-medium\">Your report has been successfully logged and prioritized.</p>\n          <button \n            onClick={resetForm}\n            className=\"w-full py-3 bg-black text-white font-bold rounded-xl hover:bg-sandalwood-900 transition-colors shadow-md\"\n          >\n            {texts.again}\n          </button>\n        </div>\n      )}\n    </div>\n  );\n}"
      }
      fuzzy_match: "import { useState, useRef } from \'react\';\nimport { Mic, Square, Loader2, CheckCircle2, Globe } from \'lucide-react\';\nimport { clsx, type ClassValue } from \'clsx\';\nimport { twMerge } from \'tailwind-merge\';\n\nfunction cn(...inputs: ClassValue[]) {\n  return twMerge(clsx(inputs));\n}\n\nconst LANG_MESSAGES: Record<string, { title: string, subtitle: string, record: string, stop: string, analyzing: string, success: string, again: string }> = {\n  en: { title: \"Civic Voice Agent\", subtitle: \"Hold record to state an issue or criticize an ongoing municipal project. Audio is auto-translated and verified.\", record: \"RECORD\", stop: \"STOP\", analyzing: \"Analyzing Multimodal Input...\", success: \"Report logged securely.\", again: \"Report another issue\" },\n  hi: { title: \"\340\244\250\340\244\276\340\244\227\340\244\260\340\244\277\340\244\225 \340\244\265\340\245\211\340\244\257\340\244\270 \340\244\217\340\244\234\340\245\207\340\244\202\340\244\237\", subtitle: \"\340\244\225\340\244\277\340\244\270\340\245\200 \340\244\270\340\244\256\340\244\270\340\245\215\340\244\257\340\244\276 \340\244\225\340\245\213 \340\244\254\340\244\244\340\244\276\340\244\250\340\245\207 \340\244\257\340\244\276 \340\244\232\340\244\262 \340\244\260\340\244\271\340\245\200 \340\244\250\340\244\227\340\244\260\340\244\252\340\244\276\340\244\262\340\244\277\340\244\225\340\244\276 \340\244\252\340\244\260\340\244\277\340\244\257\340\245\213\340\244\234\340\244\250\340\244\276 \340\244\225\340\245\200 \340\244\206\340\244\262\340\245\213\340\244\232\340\244\250\340\244\276 \340\244\225\340\244\260\340\244\250\340\245\207 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 \340\244\260\340\244\277\340\244\225\340\245\211\340\244\260\340\245\215\340\244\241 \340\244\246\340\244\254\340\244\276\340\244\217 \340\244\260\340\244\226\340\245\207\340\244\202\340\245\244\", record: \"\340\244\260\340\244\277\340\244\225\340\245\211\340\244\260\340\245\215\340\244\241 \340\244\225\340\244\260\340\245\207\340\244\202\", stop: \"\340\244\260\340\245\201\340\244\225\340\245\207\340\244\202\", analyzing: \"\340\244\207\340\244\250\340\244\252\340\245\201\340\244\237 \340\244\225\340\244\276 \340\244\265\340\244\277\340\244\266\340\245\215\340\244\262\340\245\207\340\244\267\340\244\243 \340\244\225\340\244\260 \340\244\260\340\244\271\340\244\276 \340\244\271\340\245\210...\", success: \"\340\244\260\340\244\277\340\244\252\340\245\213\340\244\260\340\245\215\340\244\237 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244 \340\244\260\340\245\202\340\244\252 \340\244\270\340\245\207 \340\244\246\340\244\260\340\245\215\340\244\234 \340\244\225\340\245\200 \340\244\227\340\244\210\340\245\244\", again: \"\340\244\246\340\245\202\340\244\270\340\244\260\340\245\200 \340\244\270\340\244\256\340\244\270\340\245\215\340\244\257\340\244\276 \340\244\246\340\244\260\340\245\215\340\244\234 \340\244\225\340\244\260\340\245\207\340\244\202\" },\n  ta: { title: \"\340\256\225\340\257\201\340\256\237\340\256\277\340\256\256\340\256\225\340\257\215\340\256\225\340\256\263\340\257\215 \340\256\225\340\257\201\340\256\260\340\256\262\340\257\215 \340\256\256\340\257\201\340\256\225\340\256\265\340\256\260\340\257\215\", subtitle: \"\340\256\222\340\256\260\340\257\201 \340\256\232\340\256\277\340\256\225\340\257\215\340\256\225\340\256\262\340\257\210\340\256\225\340\257\215 \340\256\225\340\257\202\340\256\261 \340\256\205\340\256\262\340\257\215\340\256\262\340\256\244\340\257\201 \340\256\244\340\256\261\340\257\215\340\256\252\340\257\213\340\256\244\340\257\210\340\256\257 \340\256\244\340\256\277\340\256\237\340\257\215\340\256\237\340\256\244\340\257\215\340\256\244\340\257\210 \340\256\265\340\256\277\340\256\256\340\256\260\340\257\215\340\256\232\340\256\277\340\256\225\340\257\215\340\256\225 \340\256\252\340\256\244\340\256\277\340\256\265\340\257\210 \340\256\205\340\256\264\3