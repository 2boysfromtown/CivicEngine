        target_content: "        config: {\n          responseModalities: [Modality.AUDIO],\n          speechConfig: {\n            voiceConfig: { prebuiltVoiceConfig: { voiceName: \"Zephyr\" } },\n          },\n          systemInstruction: \"You are a helpful civic operator assistant answering questions about reporting municipal issues.\",\n        },\n        callbacks: {\n          onmessage: (message: LiveServerMessage) => {\n            const audio = message.serverContent?.modelTurn?.parts[0]?.inlineData?.data;\n            if (audio && clientWs.readyState === 1) clientWs.send(JSON.stringify({ audio }));\n            if (message.serverContent?.interrupted && clientWs.readyState === 1)\n              clientWs.send(JSON.stringify({ interrupted: true }));\n          },\n        },"
        replacement_content: "        config: {\n          responseModalities: [Modality.AUDIO],\n          speechConfig: {\n            voiceConfig: { prebuiltVoiceConfig: { voiceName: \"Zephyr\" } },\n          },\n          systemInstruction: \"You are an advanced, hyper-objective civic intelligence agent deployed to sit between local citizens and municipal authorities. Your job is to collect details about a municipal issue from the citizen over this live voice call. You need their location (approximate or landmark) and the issue description. Ask short, polite follow-up questions. Once you have enough information to log a report, use the submit_report tool and tell the user their report has been logged successfully.\",\n          tools: [{\n            functionDeclarations: [\n              {\n                name: \"submit_report\",\n                description: \"Submits a civic issue report to the municipal system.\",\n                parameters: {\n                  type: \"OBJECT\",\n                  properties: {\n                    category: { type: \"STRING\", description: \"Issue category (e.g. ROADS, WATER_SUPPLY, SANITATION, ELECTRICITY, PUBLIC_SAFETY, OTHER)\" },\n                    summary: { type: \"STRING\", description: \"Summary of the issue in English\" },\n                    location: { type: \"STRING\", description: \"Location or landmark\" },\n                    severity: { type: \"INTEGER\", description: \"Severity rating from 1 to 5 based on gravity\" }\n                  },\n                  required: [\"category\", \"summary\", \"location\", \"severity\"]\n                }\n              }\n            ]\n          }]\n        },\n        callbacks: {\n          onmessage: (message: LiveServerMessage) => {\n            const audio = message.serverContent?.modelTurn?.parts[0]?.inlineData?.data;\n            if (audio && clientWs.readyState === 1) clientWs.send(JSON.stringify({ audio }));\n            if (message.serverContent?.interrupted && clientWs.readyState === 1)\n              clientWs.send(JSON.stringify({ interrupted: true }));\n\n            if (message.toolCall) {\n              const call = message.toolCall.functionCalls[0];\n              if (call.name === \'submit_report\') {\n                const args = call.args as any;\n                const Sg = args.severity || 1;\n                const priorityScore = (2.0 * Sg) + (1.5 * Math.log(1)) + 0;\n                \n                const newIssue = {\n                  issue_id: `REP_LIVE_${Math.floor(Math.random() * 100000)}`,\n                  coordinates: { latitude: 0, longitude: 0 },\n                  category: args.category || \'OTHER\',\n                  status: \'OPEN\',\n                  severity_score: Sg,\n                  priority_score: priorityScore,\n                  citizen_upvote_count: 0,\n                  executive_summary: `${args.summary} [Live Reporter Location: ${args.location}]`,\n                  created_at: new Date().toISOString(),\n                  updated_at: new Date().toISOString(),\n                };\n                issues.push(newIssue);\n\n                session.sendToolResponse({\n                  functionResponses: [{\n                    name: call.name,\n                    id: call.id,\n                    response: { result: \"Report submitted successfully.\" }\n                  }]\n                });\n              }\n            }\n          },\n        },"
      }
      num_matches: 1
    }
  }
}
