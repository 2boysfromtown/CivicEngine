    combined_output {
      full: "<truncated 23 bytes>\nnear the central school entrance.\",    created_at: new Date(Date.now() - 3600000 * 24 * 5).toISOString(),    updated_at: new Date().toISOString(),  }];let projects: any[] = [  {    project_id: \"PROJ_OVERBRIDGE_W4\",    title: \"Ward 4 Overbridge Construction\",    department: \"Highways & Infrastructure\",    allocated_budget: \"\342\202\2714.2 Crores\",    target_completion_date: \"2026-12-15\",    sentiment_summary: {      positive_votes: 120,      negative_criticisms: 412,      ai_sentiment_index: -0.45,      top_criticism_theme: \"Extended road closures without alternative traffic route coordination.\"    }  },  {    project_id: \"PROJ_SOLAR_LIGHTS\",    title: \"City-wide Solar Streetlights\",    department: \"Energy & Public Safety\",    allocated_budget: \"\342\202\2711.5 Crores\",    target_completion_date: \"2026-08-30\",    sentiment_summary: {      positive_votes: 850,      negative_criticisms: 120,      ai_sentiment_index: 0.78,      top_criticism_theme: \"Installation delays in Zone B.\"    }  }];const SYSTEM_INSTRUCTION = `SYSTEM INSTRUCTION: Senior Civic Data Architect & Real-Time Multimodal AnalystROLE AND OBJECTIVE:You are an advanced, hyper-objective civic intelligence agent deployed to sit between local citizens and municipal authorities. Your primary task is to process citizen communications (live audio feeds, uploaded audio recordings, images, and geolocation strings) to verify legitimacy, extract structural context, resolve regional accents/languages, and output flawless, machine-readable JSON data. You must filter out emotional fluff, exaggerations, or irrelevant spam, converting raw input into structural facts.FUNCTIONAL CAPABILITIES:1. Dynamic Audio Processing & Translation: Transcribe speech from any Indian regional language or dialect (including Tamil, Hindi, Kannada, Telugu, etc.) and code-switched English (Hinglish/Tanglish). Natively translate the core meaning to precise English.2. Multimodal Visual Verification: Analyze uploaded images to verify if a legitimate municipal or civic problem is present (e.g., potholes, garbage heaps, broken streetlights, water stagnation, damaged public property). Flag the image as spam if it contains selfies, internet memes, unrelated graphics, or shows no actual infrastructure failure.3. Structural Severity Grading: Based entirely on the visual evidence and descriptive audio gravity, assign an objective Severity Rating from 1 (minor cosmetic issue) to 5 (critical safety hazard or total systemic failure).CONVERSATIONAL PROTOCOL (FOR LIVE INTERACTIVE VOICE SESSIONS):- If vital parameters are missing from the citizen\'s report (such as specific landmarks, approximate scale of the problem, or clear impacts on safety), ask a short, polite, conversational follow-up question in the speaker\'s language.- Do not speak like an AI assistant. Speak like an efficient, empathetic local emergency operator. Keep responses under 20 words.OUTPUT SCHEMA SPECIFICATION:When the conversation concludes, or when a static multi-modal payload is evaluated, you must emit a single JSON object. Do not include markdown code block formatting (e.g., do not wrap in \\`\\`\\`json). Strictly adhere to the following schema structure:{  \"is_legitimate_civic_issue\": boolean,  \"spam_reason\": \"string or null if pass\",  \"extracted_parameters\": {    \"category\": \"ROADS\" | \"WATER_SUPPLY\" | \"SANITATION\" | \"ELECTRICITY\" | \"PUBLIC_SAFETY\" | \"OTHER\",    \"raw_transcription_native\": \"string\",    \"translated_summary_english\": \"string\",    \"visual_evidence_analysis\": \"string detailing what is seen in the image\",    \"landmark_or_location_clues\": \"string describing any mentioned local landmarks\"  },  \"metrics\": {    \"severity_rating\": integer (1-5),    \"safety_hazard_present\": boolean,    \"estimated_affected_population_density\": \"LOW\" | \"MEDIUM\" | \"HIGH\"  },  \"project_criticism\": {    \"is_criticism_of_existing_work\": boolean,    \"associated_project_name_if_mentioned\": \"string or null\",    \"sentiment_score\": float (-1.0 to 1.0)  },  \"requires_live_followup\": boolean}CRITICAL CONSTRAINTS:- Never assume coordinates or details not present in the input or explicitly stated by the user.- If \"is_legitimate_civic_issue\" is evaluated as false, immediately nullify the remaining telemetry metrics and state the exact spam reason.- Output absolute JSON. No conversational intro or outro text.`;app.use(express.json());app.post(\'/api/process-civic-report\', upload.fields([{ name: \'audio\', maxCount: 1 }, { name: \'image\', maxCount: 1 }]), async (req, res) => {  try {    const lat = req.body.lat;    const lng = req.body.lng;    const textDesc = req.body.text || \'\';        // Type checking for req.files when using upload.fields    const files = req.files as { [fieldname: string]: Express.Multer.File[] };    const audioFile = files?.[\'audio\']?.[0];    const imageFile = files?.[\'image\']?.[0];        if (!audioFile && !imageFile && !textDesc) {       return res.status(400).json({ error: \'Please provide audio, image, or text description.\' });    }    const parts: any[] = [];        if (audioFile) {      parts.push({        inlineData: {          data: audioFile.buffer.toString(\'base64\'),          mimeType: audioFile.mimetype,        },      });    }    if (imageFile) {      parts.push({        inlineData: {          data: imageFile.buffer.toString(\'base64\'),          mimeType: imageFile.mimetype,        },      });    }    let userPrompt = `Analyze this civic report. Coordinates: lat ${lat}, lng ${lng}.`;    if (textDesc) {       userPrompt += ` User provided text description: \"${textDesc}\"`;    }    parts.push({ text: userPrompt });    const aiClient = getAI();    const response = await aiClient.models.generateContent({      model: \'gemini-3.5-flash\',      contents: [        {          role: \'user\',          parts: parts        }      ],      config: {        systemInstruction: SYSTEM_INSTRUCTION,        responseMimeType: \'application/json\',      }    });    let rawOutput = response.text || \'{}\';    // Remove markdown code blocks if present    if (rawOutput.startsWith(\'\\`\\`\\`json\')) {       rawOutput = rawOutput.replace(/\\`\\`\\`json/g, \'\').replace(/\\`\\`\\`/g, \'\').trim();    } else if (rawOutput.startsWith(\'\\`\\`\\`\')) {       rawOutput = rawOutput.replace(/\\`\\`\\`/g, \'\').trim();    }        const parsed = JSON.parse(rawOutput);    // If it\'s a legitimate issue, add it to our in-memory store    if (parsed.is_legitimate_civic_issue) {       const Sg = parsed.metrics?.severity_rating || 1;       const Vc = 0; // new report       const deltaT = 0;              const Ws = 2.0;       const Wv = 1.5;       const Wt = 1.0;              const priorityScore = (Ws * Sg) + (Wv * Math.log(Vc + 1)) + (Wt * (deltaT / 24));              const newIssue = {         issue_id: `REP_${Math.floor(Math.random() * 100000)}`,         coordinates: { latitude: parseFloat(lat || \'0\'), longitude: parseFloat(lng || \'0\') },         category: parsed.extracted_parameters?.category || \'OTHER\',         status: \'OPEN\',         severity_score: Sg,         priority_score: priorityScore,         citizen_upvote_count: Vc,         executive_summary: parsed.extracted_parameters?.translated_summary_english || \'No summary\',         created_at: new Date().toISOString(),         updated_at: new Date().toISOString(),       };       issues.push(newIssue);    }    res.json({ success: true, ai_response: parsed });  } catch (error: any) {    console.error(\'Error processing report:\', error);    res.status(500).json({ error: error.message || \'Failed to process report\' });  }});app.get(\'/api/issues\', (req, res) => {  res.json(issues);});app.get(\'/api/projects\', (req, res) => {  res.json(projects);});// Vite middleware for developmentasync function startServer() {  if (process.env.NODE_ENV !== \"production\") {    const vite = await createViteServer({      server: { middlewareMode: true },      appType: \"spa\",    });    app.use(vite.middlewares);  } else {    const distPath = path.join(process.cwd(), \'dist\');    app.use(express.static(distPath));    app.get(\'*\', (req, res) => {      res.sendFile(path.join(distPath, \'index.html\'));    });  }  app.listen(PORT, \"0.0.0.0\", () => {    console.log(`Server running on http://localhost:${PORT}`);  });}startServer();"
    }
    command_line: "cat server.ts"
    proposed_command_line: "cat server.ts"
  }
}
