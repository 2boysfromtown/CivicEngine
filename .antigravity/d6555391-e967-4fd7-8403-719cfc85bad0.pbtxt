    instruction: "Enhance /api/issues endpoint and add /api/issues/:id/photo endpoint with Gemini verification"
    replacement_infos {
      original_chunk {
        target_content: "app.get(\'/api/issues\', (req, res) => {\n  res.json(issues);\n});\n\napp.post(\'/api/issues\', (req, res) => {\n  const { category, executive_summary, severity_score, latitude, longitude } = req.body;\n  \n  const Sg = parseInt(severity_score || \'3\', 10);\n  const Vc = 1; // start with 1 upvote\n  const priorityScore = (2.0 * Sg) + (1.5 * Math.log(Vc + 1));\n  \n  let lat = parseFloat(latitude);\n  let lng = parseFloat(longitude);\n  \n  if (isNaN(lat) || lat === 0 || isNaN(lng) || lng === 0) {\n    lat = 12.687 + (Math.random() - 0.5) * 0.01;\n    lng = 78.615 + (Math.random() - 0.5) * 0.01;\n  }\n  \n  const newIssue = {\n    issue_id: `REP_${Math.floor(Math.random() * 100000)}`,\n    coordinates: { latitude: lat, longitude: lng },\n    category: category || \'OTHER\',\n    status: \'OPEN\',\n    severity_score: Sg,\n    priority_score: priorityScore,\n    citizen_upvote_count: Vc,\n    executive_summary: executive_summary || \'No summary\',\n    created_at: new Date().toISOString(),\n    updated_at: new Date().toISOString(),\n  };\n  \n  issues.unshift(newIssue); // put at front so it appears on top or recent lists\n  res.status(201).json(newIssue);\n});"
        replacement_content: "app.get(\'/api/issues\', (req, res) => {\n  res.json(issues);\n});\n\napp.post(\'/api/issues\', upload.single(\'image\'), async (req, res) => {\n  try {\n    const { category, executive_summary, severity_score, latitude, longitude } = req.body;\n    const uploadedFile = req.file;\n    \n    let Sg = parseInt(severity_score || \'3\', 10);\n    let cat = category || \'OTHER\';\n    let summary = executive_summary || \'No summary\';\n    let isVerified = false;\n    let imageUrl = \'\';\n    let spamReason = null;\n    let visualAnalysis = \'\';\n    let status = \'OPEN\';\n\n    let lat = parseFloat(latitude);\n    let lng = parseFloat(longitude);\n    \n    if (isNaN(lat) || lat === 0 || isNaN(lng) || lng === 0) {\n      lat = 12.687 + (Math.random() - 0.5) * 0.01;\n      lng = 78.615 + (Math.random() - 0.5) * 0.01;\n    }\n\n    if (uploadedFile) {\n      imageUrl = `data:${uploadedFile.mimetype};base64,${uploadedFile.buffer.toString(\'base64\')}`;\n      \n      try {\n        const aiClient = getAI();\n        const response = await aiClient.models.generateContent({\n          model: \'gemini-3.5-flash\',\n          contents: [\n            {\n              role: \'user\',\n              parts: [\n                {\n                  inlineData: {\n                    data: uploadedFile.buffer.toString(\'base64\'),\n                    mimeType: uploadedFile.mimetype,\n                  }\n                },\n                {\n                  text: `Analyze this uploaded image for a civic report. \n                  User description: \"${summary}\"\n                  User Category: \"${cat}\"\n                  User Severity (1-5): ${Sg}\n\n                  Determine if this is a legitimate civic or municipal infrastructure/public service issue (e.g. potholes, broken lights, trash heaps, water leakage, public safety concerns) or spam (e.g. selfies, internet memes, landscapes, clean indoor scenes with no issues).\n\n                  Reply ONLY with a JSON object of this structure:\n                  {\n                    \"is_legitimate_civic_issue\": boolean,\n                    \"spam_reason\": \"string or null if pass\",\n                    \"adjusted_category\": \"ROADS\" | \"WATER_SUPPLY\" | \"SANITATION\" | \"ELECTRICITY\" | \"PUBLIC_SAFETY\" | \"OTHER\",\n                    \"adjusted_severity_score\": number (1-5),\n                    \"visual_analysis_summary\": \"string describing what is seen in the image\"\n                  }`\n                }\n              ]\n            }\n          ],\n          config: {\n            responseMimeType: \'application/json\',\n          }\n        });\n\n        let rawOutput = response.text || \'{}\';\n        if (rawOutput.startsWith(\'\\`\\`\\`json\')) {\n          rawOutput = rawOutput.replace(/\\`\\`\\`json/g, \'\').replace(/\\`\\`\\`/g, \'\').trim();\n        } else if (rawOutput.startsWith(\'\\`\\`\\`\')) {\n          rawOutput = rawOutput.replace(/\\`\\`\\`/g, \'\').trim();\n        }\n\n        const parsed = JSON.parse(rawOutput);\n        isVerified = !!parsed.is_legitimate_civic_issue;\n        if (!isVerified) {\n          spamReason = parsed.spam_reason || \'Image analyzed as non-civic/spam\';\n          status = \'REJECTED\';\n        } else {\n          cat = parsed.adjusted_category || cat;\n          Sg = parsed.adjusted_severity_score || Sg;\n          visualAnalysis = parsed.visual_analysis_summary || \'\';\n        }\n      } catch (geminiErr) {\n        console.error(\'Error in Gemini image verification for quick-post:\', geminiErr);\n        // Fallback to accepting without Gemini verification if Gemini fails\n        isVerified = false;\n      }\n    }\n\n    const Vc = 1; // start with 1 upvote\n    const priorityScore = (2.0 * Sg) + (1.5 * Math.log(Vc + 1));\n    \n    const newIssue = {\n      issue_id: `REP_${Math.floor(Math.random() * 100000)}`,\n      coordinates: { latitude: lat, longitude: lng },\n      category: cat,\n      status: status,\n      severity_score: Sg,\n      priority_score: priorityScore,\n      citizen_upvote_count: Vc,\n      executive_summary: summary,\n      is_verified: isVerified,\n      image_url: imageUrl,\n      spam_reason: spamReason,\n      visual_analysis: visualAnalysis,\n      created_at: new Date().toISOString(),\n      updated_at: new Date().toISOString(),\n    };\n    \n    issues.unshift(newIssue);\n    res.status(201).json(newIssue);\n  } catch (error: any) {\n    console.error(\'Error in quick post:\', error);\n    res.status(500).json({ error: error.message || \'Failed to submit quick post\' });\n  }\n});\n\n// Post-live call photo attachment with Gemini verification\napp.post(\'/api/issues/:id/photo\', upload.single(\'image\'), async (req, res) => {\n  try {\n    const issueId = req.params.id;\n    const uploadedFile = req.file;\n    const issue = issues.find(i => i.issue_id === issueId);\n    \n    if (!issue) {\n      return res.status(404).json({ error: \'Issue not found\' });\n    }\n    \n    if (!uploadedFile) {\n      return res.status(400).json({ error: \'No image uploaded\' });\n    }\n\n    const imageUrl = `data:${uploadedFile.mimetype};base64,${uploadedFile.buffer.toString(\'base64\')}`;\n    issue.image_url = imageUrl;\n    \n    try {\n      const aiClient = getAI();\n      const response = await aiClient.models.generateContent({\n        model: \'gemini-3.5-flash\',\n        contents: [\n          {\n            role: \'user\',\n            parts: [\n              {\n                inlineData: {\n                  data: uploadedFile.buffer.toString(\'base64\'),\n                  mimeType: uploadedFile.mimetype,\n                }\n              },\n              {\n                text: `Analyze this uploaded image to verify if it matches or illustrates the civic issue.\n                Issue description: \"${issue.executive_summary}\"\n                Issue Category: \"${issue.category}\"\n                Current Severity: ${issue.severity_score}\n\n                Determine if this image is a legitimate match for the issue, or if it is spam/fake.\n\n                Reply ONLY with a JSON object of this structure:\n                {\n                  \"is_legitimate_civic_issue\": boolean,\n                  \"spam_reason\": \"string or null if pass\",\n                  \"adjusted_category\": \"ROADS\" | \"WATER_SUPPLY\" | \"SANITATION\" | \"ELECTRICITY\" | \"PUBLIC_SAFETY\" | \"OTHER\",\n                  \"adjusted_severity_score\": number (1-5),\n                  \"visual_analysis_summary\": \"string describing what is seen in the image\"\n                }`\n              }\n            ]\n          }\n        ],\n        config: {\n          responseMimeType: \'application/json\',\n        }\n      });\n\n      let rawOutput = response.text || \'{}\';\n      if (rawOutput.startsWith(\'\\`\\`\\`json\')) {\n        rawOutput = rawOutput.replace(/\\`\\`\\`json/g, \'\').replace(/\\`\\`\\`/g, \'\').trim();\n      } else if (rawOutput.startsWith(\'\\`\\`\\`\')) {\n        rawOutput = rawOutput.replace(/\\`\\`\\`/g, \'\').trim();\n      }\n\n      const parsed = JSON.parse(rawOutput);\n      issue.is_verified = !!parsed.is_legitimate_civic_issue;\n      if (!issue.is_verified) {\n        issue.spam_reason = parsed.spam_reason || \'Image analyzed as non-civic/spam\';\n        issue.status = \'REJECTED\';\n      } else {\n        issue.category = parsed.adjusted_category || issue.category;\n        issue.severity_score = parsed.adjusted_severity_score || issue.severity_score;\n        issue.visual_analysis = parsed.visual_analysis_summary || \'\';\n        issue.spam_reason = null;\n        issue.status = \'OPEN\'; // ensure it\'s open if verified\n      }\n      \n      // Recalculate priority\n      const Sg = issue.severity_score;\n      const Vc = issue.citizen_upvote_count;\n      issue.priority_score = (2.0 * Sg) + (1.5 * Math.log(Vc + 1));\n      issue.updated_at = new Date().toISOString();\n      \n    } catch (geminiErr) {\n      console.error(\'Error in post-live-call Gemini photo verification:\', geminiErr);\n      issue.is_verified = false;\n    }\n\n    res.json(issue);\n  } catch (error: any) {\n    console.error(\'Error adding photo to issue:\', error);\n    res.status(500).json({ error: error.message || \'Failed to attach photo\' });\n  }\n});"
      }
      num_matches: 1
    }
  }
