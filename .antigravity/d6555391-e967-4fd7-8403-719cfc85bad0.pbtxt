    instruction: "Implement single-vote tracking and toggling in server.ts for issues and projects"
    replacement_infos {
      original_chunk {
        target_content: "app.post(\'/api/issues/:id/upvote\', (req, res) => {\n  const issue = issues.find(i => i.issue_id === req.params.id);\n  if (!issue) return res.status(404).json({ error: \'Not found\' });\n  \n  issue.citizen_upvote_count += 1;\n  // Recalculate priority\n  const Sg = issue.severity_score;\n  const Vc = issue.citizen_upvote_count;\n  const deltaT = 0; // simplified\n  issue.priority_score = (2.0 * Sg) + (1.5 * Math.log(Vc + 1)) + (1.0 * (deltaT / 24));\n  issue.updated_at = new Date().toISOString();\n  \n  res.json(issue);\n});\n\napp.get(\'/api/projects\', (req, res) => {\n  res.json(projects);\n});\n\napp.post(\'/api/projects/:id/vote\', (req, res) => {\n  const proj = projects.find(p => p.project_id === req.params.id);\n  if (!proj) return res.status(404).json({ error: \'Not found\' });\n  \n  const { isPositive } = req.body || { isPositive: true };\n  if (isPositive) {\n    proj.sentiment_summary.positive_votes += 1;\n  } else {\n    proj.sentiment_summary.negative_criticisms += 1;\n  }\n  \n  res.json(proj);\n});"
        replacement_content: "app.post(\'/api/issues/:id/upvote\', express.json(), (req, res) => {\n  const issue = issues.find(i => i.issue_id === req.params.id);\n  if (!issue) return res.status(404).json({ error: \'Not found\' });\n  \n  const userId = req.body.userId || req.headers[\'x-user-id\'] || \'anonymous_user\';\n  \n  if (!issue.upvoted_by) {\n    issue.upvoted_by = [];\n  }\n  \n  const hasUpvoted = issue.upvoted_by.includes(userId);\n  \n  if (hasUpvoted) {\n    // Toggle off\n    issue.upvoted_by = issue.upvoted_by.filter((id: string) => id !== userId);\n    issue.citizen_upvote_count = Math.max(0, issue.citizen_upvote_count - 1);\n  } else {\n    // Add vote\n    issue.upvoted_by.push(userId);\n    issue.citizen_upvote_count += 1;\n  }\n  \n  // Recalculate priority\n  const Sg = issue.severity_score;\n  const Vc = issue.citizen_upvote_count;\n  const deltaT = 0; // simplified\n  issue.priority_score = (2.0 * Sg) + (1.5 * Math.log(Vc + 1)) + (1.0 * (deltaT / 24));\n  issue.updated_at = new Date().toISOString();\n  \n  res.json(issue);\n});\n\napp.get(\'/api/projects\', (req, res) => {\n  res.json(projects);\n});\n\napp.post(\'/api/projects/:id/vote\', express.json(), (req, res) => {\n  const proj = projects.find(p => p.project_id === req.params.id);\n  if (!proj) return res.status(404).json({ error: \'Not found\' });\n  \n  const userId = req.body.userId || req.headers[\'x-user-id\'] || \'anonymous_user\';\n  const { isPositive } = req.body || { isPositive: true };\n  \n  if (!proj.voted_users) {\n    proj.voted_users = {};\n  }\n  \n  const existingVote = proj.voted_users[userId];\n  \n  if (existingVote !== undefined) {\n    const clickingSame = (existingVote === true && isPositive) || (existingVote === false && !isPositive);\n    \n    if (clickingSame) {\n      // Toggle off\n      if (isPositive) {\n        proj.sentiment_summary.positive_votes = Math.max(0, proj.sentiment_summary.positive_votes - 1);\n      } else {\n        proj.sentiment_summary.negative_criticisms = Math.max(0, proj.sentiment_summary.negative_criticisms - 1);\n      }\n      delete proj.voted_users[userId];\n    } else {\n      // Switch vote\n      if (isPositive) {\n        proj.sentiment_summary.positive_votes += 1;\n        proj.sentiment_summary.negative_criticisms = Math.max(0, proj.sentiment_summary.negative_criticisms - 1);\n        proj.voted_users[userId] = true;\n      } else {\n        proj.sentiment_summary.negative_criticisms += 1;\n        proj.sentiment_summary.positive_votes = Math.max(0, proj.sentiment_summary.positive_votes - 1);\n        proj.voted_users[userId] = false;\n      }\n    }\n  } else {\n    // Fresh vote\n    if (isPositive) {\n      proj.sentiment_summary.positive_votes += 1;\n      proj.voted_users[userId] = true;\n    } else {\n      proj.sentiment_summary.negative_criticisms += 1;\n      proj.voted_users[userId] = false;\n    }\n  }\n  \n  res.json(proj);\n});"
      }
